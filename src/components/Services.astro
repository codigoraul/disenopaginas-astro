<style>
  .service-content p {
    font-size: 16px !important;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: none;
  }
  
  h2 {
    font-size: clamp(28px, 3vw, 36px) !important;
  }
  
  .section-heading h2 {
    font-size: clamp(30px, 4vw, 36px) !important;
  }
  
  .pe-h3 {
    font-size: 21px !important;
  }
  
  h2[data-astro-cid-g5jplrhu] {
    font-size: clamp(26px, 3vw, 28px) !important;
  }
  
  /* Estilo tipo "Base": tarjeta plana, imagen al ras arriba, texto con padding */
  .service-card {
    position: relative;
    border-radius: 14px !important;
    border: none;
    box-shadow: none;
    background: #ffffff;
    border: 1px solid #e4e8ef;
    padding: 0;
    overflow: hidden;
    height: 100%;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .service-card:hover {
    border-color: #004597;
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0, 69, 151, 0.10);
  }

  /* La imagen ocupa todo el ancho y toca los bordes superiores */
  .service-card .service-thumb {
    border-radius: 0 !important;
    overflow: hidden;
    margin: 0 0 20px 0;
  }

  .service-card .service-thumb img {
    border-radius: 0 !important;
    width: 100%;
    height: auto;
    display: block;
  }

  /* La imagen completa es enlace al detalle del servicio */
  .service-thumb-link {
    display: block;
    line-height: 0;
    overflow: hidden;
  }

  .service-thumb-link img {
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-thumb-link img {
    transform: scale(1.04);
  }

  .service-thumb-link:focus-visible {
    outline: 3px solid #004597;
    outline-offset: -3px;
  }

  /* Anular el "shape" heredado del template (creaba un velo blanco) */
  .shape {
    display: none !important;
  }
  
  /* El texto sí lleva padding interno */
  .service-content {
    position: relative;
    z-index: 1;
    padding: 0 30px 34px 30px;
  }
  
  /* Estilos para los títulos como enlaces */
  .service-title {
    display: block;
    font-size: clamp(22px, 2.5vw, 26px);
    font-weight: 600;
    color: #333;
    text-decoration: none;
    margin-bottom: 10px;
    transition: color 0.3s ease;
  }
  
  .service-title:hover {
    color: #011C42;
    text-decoration: none;
  }
  
  .service-section {
    background: #f4f6fa;
  }

  /* Píldora del subtítulo en azul de marca, no gris neutro */
  .service-section .section-heading .sub-title {
    background: #e8f0fb !important;
    color: #004597 !important;
    border: none !important;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  /* Más aire entre tarjetas (anula también g-xl-3 en pantallas grandes) */
  .service-section .row.g-4,
  .service-section .row.g-xl-3 {
    --bs-gutter-x: 2rem;
    --bs-gutter-y: 2rem;
  }

  @media (min-width: 1200px) {
    .service-section .row.g-xl-3 {
      --bs-gutter-x: 2.25rem;
      --bs-gutter-y: 2.25rem;
    }
  }

  /* MÓVIL: títulos de tarjeta más grandes y legibles */
  @media (max-width: 767px) {
    .service-title {
      font-size: 26px !important;
      line-height: 1.25;
      margin-bottom: 8px;
    }
    .pe-h3 {
      font-size: 19px !important;
      line-height: 1.35;
    }
    .service-content p {
      font-size: 16px !important;
      line-height: 1.6;
    }
  }

  /* MÓVIL: reducir el espacio gris lateral para que las tarjetas usen casi todo el ancho */
  @media (max-width: 575px) {
    .service-section > .container {
      padding-left: 6px !important;
      padding-right: 6px !important;
      max-width: 100% !important;
    }
    .service-section .row.g-4 {
      --bs-gutter-x: 0.5rem;
    }
    .service-section .row.g-4 > [class*="col-"] {
      padding-left: 5px !important;
      padding-right: 5px !important;
    }
  }
</style>

