---
---

<!-- Process Section -->
<section class="process-section">
    <!-- Divider -->
    <div class="divider"></div>

    <div class="container">
       <!-- Section Heading -->
       <div class="row justify-content-center">
          <div class="col-12 col-md-5 col-xl-7">
             <div class="section-heading text-center">
                <span class="sub-title">
                    Proceso para creación de su página 
                    </span>
                <h2 class="mb-0">Nuestro proceso de diseño web</h2>
             </div>
          </div>
       </div>

       <div class="divider-sm"></div>

       <!-- Process Wrap -->
       <div class="process-wrap">
          <div class="row g-4 g-lg-5">

             <!-- Process Card 1 - Combinado Análisis y Planificación -->
             <div class="col-12 col-md-6 col-lg-4">
                <div class="process-card wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="200ms">
                   <div class="process-thumb">
                      <div class="process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/><circle cx="19" cy="8" r="1.2"/></svg></div>
                      <div class="number">1</div>
                   </div>
                   <div class="process-text">
                      <h5 class="process-title mb-3">Análisis y Planificación</h5>
                      <p class="mb-0">Entendemos tus necesidades, objetivos y audiencia. Investigamos el mercado, competencia y definimos la estrategia, arquitectura del sitio y plan técnico.</p>
                   </div>
                </div>
             </div>

             <!-- Process Card 2 - Prototipado -->
             <div class="col-12 col-md-6 col-lg-4">
                <div class="process-card wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="400ms">
                   <div class="process-thumb">
                      <div class="process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M3.5 9h17"/><path d="M9.5 9v11"/><path d="M12.5 13h5M12.5 16h3"/></svg></div>
                      <div class="number">2</div>
                   </div>
                   <div class="process-text">
                      <h5 class="process-title mb-3">Prototipo y Wireframe</h5>
                      <p class="mb-0">Desarrollamos un prototipo funcional que muestra la estructura, navegación y flujo de usuario, asegurando una experiencia intuitiva desde el primer momento.</p>
                   </div>
                </div>
             </div>

             <!-- Process Card 3 - Diseño Visual -->
             <div class="col-12 col-md-6 col-lg-4">
                <div class="process-card wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="600ms">
                   <div class="process-thumb">
                      <div class="process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21a9 9 0 0 1 0-18c4.97 0 9 3.58 9 8 0 1.06-.47 2.08-1.32 2.83-.84.75-1.99 1.17-3.18 1.17H14a2 2 0 0 0-1 3.75A1.3 1.3 0 0 1 12 21"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/></svg></div>
                      <div class="number">3</div>
                   </div>
                   <div class="process-text">
                      <h5 class="process-title mb-3">Diseño de Interfaz</h5>
                      <p class="mb-0">Aplicamos tu identidad visual con paletas de colores, tipografías y componentes de diseño para crear una interfaz atractiva, consistente y profesional.</p>
                   </div>
                </div>
             </div>

             <!-- Process Card 4 - Desarrollo -->
             <div class="col-12 col-md-6 col-lg-4">
                <div class="process-card wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="800ms">
                   <div class="process-thumb">
                      <div class="process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 8l-4 4 4 4"/><path d="M17 8l4 4-4 4"/><path d="M14 4l-4 16"/></svg></div>
                      <div class="number">4</div>
                   </div>
                   <div class="process-text">
                      <h5 class="process-title mb-3">Desarrollo Técnico</h5>
                      <p class="mb-0">Implementamos el sitio con tecnologías modernas: WordPress para sitios autoadministrables o Astro/React para máxima velocidad y rendimiento.</p>
                   </div>
                </div>
             </div>

             <!-- Process Card 5 - Pruebas -->
             <div class="col-12 col-md-6 col-lg-4">
                <div class="process-card wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="1000ms">
                   <div class="process-thumb">
                      <div class="process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
                      <div class="number">5</div>
                   </div>
                   <div class="process-text">
                      <h5 class="process-title mb-3">Pruebas y Optimización</h5>
                      <p class="mb-0">Realizamos pruebas exhaustivas de funcionalidad, rendimiento, compatibilidad móvil y SEO para garantizar la mejor calidad en todos los aspectos.</p>
                   </div>
                </div>
             </div>

             <!-- Process Card 6 - Lanzamiento -->
             <div class="col-12 col-md-6 col-lg-4">
                <div class="process-card wow fadeInUp" data-wow-duration="1000ms" data-wow-delay="1200ms">
                   <div class="process-thumb">
                      <div class="process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13a8 8 0 0 1 7 7 6 6 0 0 0 3-5 9 9 0 0 0 6-8 3 3 0 0 0-3-3 9 9 0 0 0-8 6 6 6 0 0 0-5 3"/><path d="M7 14a6 6 0 0 0-3 6 6 6 0 0 0 6-3"/><circle cx="15" cy="9" r="1"/></svg></div>
                      <div class="number">6</div>
                   </div>
                   <div class="process-text">
                      <h5 class="process-title mb-3">Lanzamiento y Soporte</h5>
                      <p class="mb-0">Publicamos tu sitio web y ofrecemos soporte continuo. Te capacitamos para que administres tu sitio y te acompañamos con mejoras futuras.</p>
                   </div>
                </div>
             </div>
          </div>
          
       </div>
    </div>

    <!-- Divider -->
    <div class="divider"></div>
 </section>

<style>
  /* Estilos específicos para el componente Proceso */
  
  /* Cambiar color de fondo de los números en las tarjetas de proceso */
  .process-card .process-thumb .number {
    background-color: #1bdcf5 !important;
    width: 28px;
    height: 28px;
    right: -14px;
    top: -9px;
    font-size: 13px;
    border-width: 2px;
  }
  

  /* Íconos SVG del proceso (reemplazan imágenes rotas) */
  .process-card .process-thumb { max-width: 56px; }
  .process-icon {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #eef3fb;
    color: #2F5FA8;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform .25s ease, background .25s ease;
  }
  .process-icon svg { width: 23px; height: 23px; }
  .process-card:hover .process-icon { transform: translateY(-3px); background: #e3ecf9; }
</style>