---
---

  <!-- Testimonial Section -->
  <section class="testimonial-section bg-secondary">
    <!-- Divider -->
    <div class="divider"></div>

    <div class="container">
       <div class="row g-5 align-items-end">
          <div class="col-12 col-lg-8">
             <div class="section-heading">
                <span class="sub-title">Testimonios</span>
                <h2 class="mb-0">Que dicen los clientes <br>sobre nosotros</h2>
             </div>
          </div>
          <div class="col-12 col-lg-4">
             <div class="text-lg-end">
                <a href="https://shorturl.at/u3nB5" target="_blank" class="btn btn-primary">Ver todas las reseñas <i
                      class="ti ti-arrow-up-right"></i></a>
             </div>
          </div>
       </div>
    </div>

    <div class="divider-sm"></div>

    <div class="container">
       <div class="row g-4 g-xl-5">
          <div class="col-12 col-md-7 col-lg-8">
             <div class="tab-content" id="testimonial-tabContent">
                <div class="tab-pane fade" id="testimonial-one" role="tabpanel" aria-labelledby="testimonial-tab-one">
                   <!-- Testimonial Card -->
                   <div class="testimonial-card style-two">
                      <div class="ratings">
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                      </div>
                      <p class="testimonial-text">"Me asesoraron para solucionar problemas de hosting, migrar correos y la puesta en servicio de mi página web. Excelente servicio, profesional muy comprometido y competente, resultados mejores a los esperados, recomendable absolutamente."</p>
                      <div class="d-flex gap-4 flex-wrap align-items-center justify-content-between">
                         <!-- Testimonials Nav -->
                         <div class="testimonials-nav-link">
                            <img loading="lazy" src="/assets/img/testimonios/gerardo.png" alt="Gerardo Ojeda">
                            <div>
                               <h4 class="mb-1">Gerardo Ojeda</h4>
                               <p class="mb-0">Cliente Satisfecho</p>
                            </div>
                         </div>
                         <!-- Quote Icon -->
                         <div class="quote-icon ms-auto">
                            <svg width="62" height="62">
                               <use href="#double-quote-icon"></use>
                           </svg>
                         </div>
                      </div>
                   </div>
                </div>

                <div class="tab-pane fade show active" id="testimonial-two" role="tabpanel"
                   aria-labelledby="testimonial-tab-two">
                   <!-- Testimonial Card -->
                   <div class="testimonial-card style-two">
                      <div class="ratings">
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                      </div>
                      <p class="testimonial-text">"Muy buenos servicios, la página web quedó profesional y en poco tiempo. También cabe recalcar que tiene una preocupación y dedicación por cada cliente."</p>
                      <div class="d-flex gap-4 flex-wrap align-items-center justify-content-between">
                         <!-- Testimonials Nav -->
                         <div class="testimonials-nav-link">
                            <img loading="lazy" src="/assets/img/testimonios/arqueocat.png" alt="Arqueocat">
                            <div>
                               <h4 class="mb-1">Arqueocat</h4>
                               <p class="mb-0">Arqueóloga</p>
                            </div>
                         </div>
                         <!-- Quote Icon -->
                         <div class="quote-icon ms-auto">
                            <svg width="62" height="62">
                               <use href="#double-quote-icon"></use>
                           </svg>
                         </div>
                      </div>
                   </div>
                </div>

                <div class="tab-pane fade" id="testimonial-three" role="tabpanel"
                   aria-labelledby="testimonial-tab-three">
                   <!-- Testimonial Card -->
                   <div class="testimonial-card style-two">
                      <div class="ratings">
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                         <i class="ti ti-star-filled"></i>
                      </div>
                      <p class="testimonial-text">"Raúl tiene excelente disposición para ayudarte con las dudas y con las actualizaciones que necesitas."</p>
                      <div class="d-flex gap-4 flex-wrap align-items-center justify-content-between">
                         <!-- Testimonials Nav -->
                         <div class="testimonials-nav-link">
                            <img loading="lazy" src="/assets/img/testimonios/lorena.png" alt="Lorena Gacitua">
                            <div>
                               <h4 class="mb-1">Lorena Gacitua</h4>
                               <p class="mb-0">Psicóloga</p>
                            </div>
                         </div>
                         <!-- Quote Icon -->
                         <div class="quote-icon ms-auto">
                            <svg width="62" height="62">
                               <use href="#double-quote-icon"></use>
                           </svg>
                         </div>
                      </div>
                   </div>
                </div>
             </div>
          </div>

          <!-- Vertical nav tabs -->
          <div class="col-12 col-md-5 col-lg-4">
             <div class="nav flex-column gap-4" id="testimonial-tab" role="tablist" aria-orientation="vertical">
                <!-- Testimonials Nav Link -->
                <div class="testimonials-nav-link" id="testimonial-tab-one" data-bs-toggle="pill"
                   data-bs-target="#testimonial-one" role="tab" aria-controls="testimonial-one" aria-selected="true">
                   <img loading="lazy" src="/assets/img/testimonios/gerardo.png" alt="Gerardo Ojeda">
                   <div>
                      <h4 class="mb-1">Gerardo Ojeda</h4>
                      <p class="mb-0">Cliente Satisfecho</p>
                   </div>
                </div>

                <!-- Testimonials Nav Link -->
                <div class="testimonials-nav-link active" id="testimonial-tab-two" data-bs-toggle="pill"
                   data-bs-target="#testimonial-two" role="tab" aria-controls="testimonial-two" aria-selected="false">
                   <img loading="lazy" src="/assets/img/testimonios/arqueocat.png" alt="Arqueocat">
                   <div>
                      <h4 class="mb-1">Arqueocat</h4>
                      <p class="mb-0">Empresa Cliente</p>
                   </div>
                </div>

                <!-- Testimonials Nav Link -->
                <div class="testimonials-nav-link" id="testimonial-tab-three" data-bs-toggle="pill"
                   data-bs-target="#testimonial-three" role="tab" aria-controls="testimonial-three"
                   aria-selected="false">
                   <img loading="lazy" src="/assets/img/testimonios/lorena.png" alt="Lorena Gacitua">
                   <div>
                      <h4 class="mb-1">Lorena Gacitua</h4>
                      <p class="mb-0">Cliente Satisfecha</p>
                   </div>
                </div>
             </div>
          </div>
       </div>
    </div>

    <!-- Divider -->
    <div class="divider"></div>
 </section>

<style>
   /* Fondo suave, igual al de Servicios */
   .testimonial-section.bg-secondary {
     background-color: #f4f6fa !important;
   }

   /* Tarjeta del testimonio */
   .testimonial-card.style-two {
     background: #ffffff;
     border: 1px solid #e9ecf2;
     border-radius: 18px !important;
     box-shadow: 0 18px 40px -24px rgba(30, 37, 54, .22);
   }
   .testimonial-text {
     font-size: 1.0625rem !important;
     line-height: 1.75 !important;
     color: #1E2536 !important;
   }
   .testimonial-card :global(.quote-icon) { color: #d6e1f3; }

   /* Selector de clientes */
   .testimonials-nav-link {
     padding: 14px 18px !important;
     align-items: center !important;
     gap: 16px;
     background: #ffffff !important;
     border: 1px solid #e3e7ef !important;
     border-radius: 14px !important;
     cursor: pointer;
     transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
   }
   .testimonials-nav-link img {
     flex: 0 0 80px;
     aspect-ratio: 1 / 1;
     border-radius: 50%;
     object-fit: cover;
     background: #fff;
     border: 1px solid #e3e7ef;
   }
   .testimonials-nav-link h4 {
     font-size: 1.125rem !important;
     color: #1E2536 !important;
   }
   .testimonials-nav-link p {
     font-size: 0.875rem !important;
     color: #5b6478 !important;
   }
   .testimonials-nav-link:hover {
     border-color: #2F5FA8 !important;
     background: #f7f9fd !important;
   }
   .testimonials-nav-link.active {
     background: #2F5FA8 !important;
     border-color: #2F5FA8 !important;
     box-shadow: 0 12px 28px -14px rgba(47, 95, 168, .6);
   }
   .testimonials-nav-link.active h4 { color: #ffffff !important; }
   .testimonials-nav-link.active p { color: #dbe5f7 !important; }
   .testimonials-nav-link.active img { border-color: rgba(255, 255, 255, .6); }
</style>