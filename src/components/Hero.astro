---
// Componente Hero Slider para diseñopaginas.cl
---
<!-- Hero Section -->
<section class="hero-section d-flex align-items-center">
   <!-- Fondo de imágenes (desktop y móvil) que cambia con cada slide -->
   <div class="hero-video-bg">
      <div class="hero-mobile-bg" aria-hidden="true"></div>
      <div class="video-overlay"></div>
   </div>
   
   <div class="container my-auto">
      <!-- Hero Content -->
      <div class="hero-content">
         <!-- Swiper Container -->
         <div class="hero-swiper">
            <div class="swiper-wrapper">
               <!-- Slide 1 (sin animaciones wow para evitar CLS en LCP) -->
               <div class="swiper-slide">
                  <div class="row g-5">
                     <div class="col-12 hero-single-col">
                        <div class="hero-titles-container">
                           <h1 class="mb-0 hero-main-title">
                            Diseño de Páginas Web Chile
                           </h1>
                           <h2 class="hero-subtitle">Diseño Web Empresas con estilo único</h2>
                        </div>
                        <p>
                           Desarrollamos páginas web únicas con diseño creativo y tecnología de vanguardia
                           para posicionar su empresa en los primeros lugares de google.
                        </p>
                        <a class="btn border-2 btn-outline-light" href="/contacto">Contáctanos <i class="ti ti-arrow-up-right"></i></a>
                     </div>
                  </div>
               </div>

               <!-- Slide 2 -->
               <div class="swiper-slide">
                  <div class="row g-5">
                     <div class="col-12 hero-single-col">
                        <div class="hero-titles-container">
                           <h2 class="mb-0 hero-main-title">
                             Diseño Web Profesional
                           </h2>
                           <h3 class="hero-subtitle">Tu empresa con un <b>Diseño web de calidad</b></h3>
                        </div>
                        <p>
                           Su sitio web es la primera impresión de su empresa.
                           Nuestros diseños profesionales generan <strong>
                           confianza inmediata y conversiones reales</strong>.
                        </p>
                        <a class="btn border-2 btn-outline-light" href="/portafolio">Ver Portafolio <i class="ti ti-arrow-up-right"></i></a>
                     </div>
                  </div>
               </div>

               <!-- Slide 3 -->
               <div class="swiper-slide">
                  <div class="row g-5">
                     <div class="col-12 hero-single-col">
                        <div class="hero-titles-container">
                           <h2 class="mb-0 hero-main-title">
                              Su sitio web 2026 con IA
                           </h2>
                           <h3 class="hero-subtitle">Diseño Web con Inteligencia Artificial</h3>
                        </div>
                        <p>
                           La IA nos ayuda a asegurar que tu sitio sea altamente funcional y fácil de navegar para tus usuarios. Si no tienes tiempo de describir al 100% tus servicios te ayudamos con las nuevas tecnologías de la IA
                           a crear texto profesionales y acordes a tu marca.
                        </p>
                        <a class="btn border-2 btn-outline-light" href="/contacto">Solicitar Presupuesto <i class="ti ti-arrow-up-right"></i></a>
                     </div>
                  </div>
               </div>

               <!-- Slide 4 -->
               <div class="swiper-slide">
                  <div class="row g-5">
                     <div class="col-12 hero-single-col">
                        <div class="hero-titles-container">
                           <h2 class="mb-0 hero-main-title">
                             ¿Qué necesito para comenzar mi proyecto web?
                           </h2>
                           <h3 class="hero-subtitle">Comienza tu sitio web profesional hoy</h3>
                        </div>
                        <p>
                           Para comenzar tu proyecto web, necesitas:<br><br>
                           1. Información básica de tu empresa<br>
                           2. Contenido (textos e imágenes) que quieras incluir<br>
                           3. Ejemplos de sitios web que te gusten<br>
                           4. Objetivos del sitio web<br>
                           5. Dominio (si ya lo tienes)
                        </p>
                        <a class="btn border-2 btn-outline-light" href="/contacto">Comenzar Ahora <i class="ti ti-arrow-up-right"></i></a>
                     </div>
                  </div>
               </div>
            </div>

            <!-- Swiper Pagination -->
            <div class="swiper-pagination hero-pagination"></div>
         </div>
      </div>
   </div>

</section>

<style>
/* Hero Slider */
.swiper-slide {
  margin-top: 165px;
}

/* Centrar verticalmente el contenido de la segunda columna */
.swiper-slide .row {
  align-items: center;
  min-height: 100%;
}

.hero-single-col {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0;
}

/* La columna única apila subtítulo, título, párrafo y botón a la izquierda */
.hero-single-col .hero-titles-container {
  height: auto;
  margin-bottom: 0.5rem;
}

/* Grupo de dos botones CTA lado a lado */
.hero-cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  align-items: center;
}

@media (max-width: 768px) {
  .hero-cta-group {
    justify-content: center;
  }
}

/* Botón CTA profesional: ancho según contenido, no estirado */
.hero-single-col .btn-outline-light {
  align-self: flex-start;
  width: auto;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #004597 !important;
  color: #ffffff !important;
  border: 2px solid #004597 !important;
  border-radius: 8px;
  padding: 13px 34px;
  font-weight: 600;
  box-shadow: 0 6px 18px rgba(0, 69, 151, 0.30);
  transition: all 0.3s ease;
}

.hero-single-col .btn-outline-light:hover {
  background: #00356f !important;
  border-color: #00356f !important;
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(0, 69, 151, 0.45);
}

@media (max-width: 768px) {
  .hero-single-col .btn-outline-light {
    align-self: center;
  }
}

@media only screen and (max-width: 568px) {
    .swiper-slide {
      margin-top: 80px;
    }
}

/* Hero Section Base */
.hero-section {
  position: relative;
  height: 700px;
  margin: 0;
  padding: 0;
  overflow: hidden;
  color: #ffffff;
  display: flex;
  align-items: center;
}

/* Video de fondo */
.hero-video-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
}

/* Imagen de fondo dinámica (todos los tamaños de pantalla) */
.hero-mobile-bg {
  display: block;
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background-color: #011c42;
  /* Imagen inicial en CSS para que el navegador la descubra de inmediato (LCP) */
  background-image: url('/assets/img/heroes/slider-movil-1.webp');
  background-size: cover;
  background-position: center;
  transition: background-image 0.5s ease;
}

/* Desktop: fondo degradado azul para el primer slide */
@media (min-width: 992px) {
  .hero-mobile-bg {
    background-image: url('/assets/img/heroes/slider-desktop-1.webp');
  }
  /* Slide 1 (fondo claro): texto oscuro en el primer pintado, antes de que corra el JS */
  .hero-swiper:not(.is-initialized) .hero-main-title { color: #004597 !important; }
  .hero-swiper:not(.is-initialized) .hero-subtitle { color: #004597 !important; text-shadow: none !important; }
  .hero-swiper:not(.is-initialized) .hero-content p { color: #2b3a55 !important; }
}

/* Texto oscuro cuando el slide activo tiene fondo claro (desktop) */
@media (min-width: 992px) {
  :global(.hero-section.light-slide) .hero-main-title {
    color: #004597 !important;
  }
  :global(.hero-section.light-slide) .hero-subtitle {
    color: #004597 !important;
    text-shadow: none !important;
  }
  :global(.hero-section.light-slide) .hero-content p {
    color: #2b3a55 !important;
  }
}

/* Primer slide visible antes de que corra el JS: mejora FCP/LCP y evita CLS */
.hero-swiper:not(.is-initialized) .swiper-slide:first-child {
  display: block;
  opacity: 1;
}


.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* Sin overlay por defecto (desktop): el degradado del fondo se ve limpio.
     El oscurecido solo se aplica en móvil (más abajo). */
  background: transparent;
  z-index: 2;
}

/* Hero Content Container */
.hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
  margin: 0 auto;
  padding: 20px 15px;
  max-width: 1320px;
}

/* El título usa todo el ancho disponible para quedar en una línea */
.hero-single-col .hero-main-title {
  max-width: 100%;
  white-space: nowrap;
}

@media (max-width: 991px) {
  .hero-single-col .hero-main-title {
    white-space: normal;
  }
}

/* === Mejoras de presentación del slider en MÓVIL === */
@media (max-width: 991px) {
  /* Overlay más oscuro (degradado) para que el texto resalte sobre las fotos claras */
  .video-overlay {
    background: linear-gradient(180deg, rgba(1, 28, 66, 0.45) 0%, rgba(1, 28, 66, 0.72) 100%);
  }
  /* Subtítulo en celeste corporativo como acento de marca */
  .hero-section .hero-content .hero-subtitle {
    color: #60E1FD !important;
  }
  /* Aire entre el párrafo y el botón (el CSS móvil ponía el párrafo pegado) */
  .hero-section .hero-single-col .btn-outline-light {
    margin-top: 1.6rem !important;
  }
  /* Un poco más de respiro entre títulos y párrafo */
  .hero-section .hero-content .hero-titles-container {
    margin-bottom: 1rem !important;
  }
}

/* Hero Titles */
.hero-titles-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}

.hero-main-title {
  order: 2;
  font-size: 60px;
  font-weight: 700;
  line-height: 1.15;
  color: #ffffff !important;
  margin-bottom: 1.5rem;
}

.hero-subtitle {
  order: 1;
  font-size: 1.05rem !important;
  color: #ffffff !important;
  margin-bottom: 0.75rem;
  font-family: 'Inter', sans-serif;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

/* Hero Content */
.hero-content p {
  font-size: 1.1rem;
  line-height: 1.7;
  margin-bottom: 2rem;
  max-width: 600px;
}

/* Responsive Adjustments */
@media (max-width: 992px) {
  .hero-main-title {
    font-size: 1.5rem !important;
  }

  .hero-subtitle {
    font-size: 1rem !important;
  }
}

@media (max-width: 768px) {
  .hero-section {
    padding: 80px 0;
    text-align: center;
  }
  
  .hero-main-title {
    font-size: 1.8rem !important;
  }
  
  .hero-subtitle {
    font-size: 1rem;
  }
  
  .hero-content p {
    margin-left: auto;
    margin-right: auto;
  }
}

/* Swiper Container */
.hero-swiper {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
}

/* Slides */
.hero-swiper .swiper-slide {
  display: none;
  opacity: 0;
  transition: opacity 0.5s ease;
}

.hero-swiper .swiper-slide-active {
  display: block;
  opacity: 1;
}

/* Pagination */
.hero-pagination {
  position: absolute;
  bottom: -150px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
  z-index: 10;
}

.hero-pagination .swiper-pagination-bullet {
  width: 10px;
  height: 10px;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-pagination .swiper-pagination-bullet-active {
  background: #004597;
  transform: scale(1.3);
  border-color: #004597;
}
</style>

<script>
// Simple slider without Swiper dependency
document.addEventListener('DOMContentLoaded', function() {
  const slides = document.querySelectorAll('.swiper-slide');
  const paginationContainer = document.querySelector('.hero-pagination');
  const mobileBg = document.querySelector('.hero-mobile-bg');
  let currentSlide = 0;
  let slideInterval;

  // Imágenes de fondo (una por slide) — set distinto para desktop y móvil
  const isDesktop = window.matchMedia('(min-width: 992px)');
  const mobileImages = [
    '/assets/img/heroes/slider-movil-1.webp',
    '/assets/img/heroes/slider-movil-2.webp',
    '/assets/img/heroes/slider-movil-3.webp',
    '/assets/img/heroes/slider-movil-1.webp'
  ];
  const desktopImages = [
    '/assets/img/heroes/slider-desktop-1.webp',
    '/assets/img/heroes/slider-desktop-2.webp',
    '/assets/img/heroes/slider-desktop-3.webp',
    '/assets/img/heroes/slider-desktop-1.webp'
  ];
  // Slides con fondo CLARO en desktop (texto oscuro): 0=slide1, 1=slide2, 3=slide4
  const lightSlidesDesktop = [0, 1, 3];
  const mobileBgImages = isDesktop.matches ? desktopImages : mobileImages;

  // Clear any existing bullets first
  if (paginationContainer) {
    paginationContainer.innerHTML = '';
    
    // Create exactly 4 bullets
    for (let i = 0; i < 4; i++) {
      const bullet = document.createElement('span');
      bullet.className = 'swiper-pagination-bullet';
      bullet.addEventListener('click', () => {
        currentSlide = i;
        showSlide(currentSlide);
        startSlider();
      });
      paginationContainer.appendChild(bullet);
    }
  }

  function showSlide(index) {
    const pagination = document.querySelectorAll('.swiper-pagination-bullet');
    slides.forEach(slide => slide.classList.remove('swiper-slide-active'));
    pagination.forEach(bullet => bullet.classList.remove('swiper-pagination-bullet-active'));

    if (slides[index]) {
      slides[index].classList.add('swiper-slide-active');
    }
    if (pagination[index]) {
      pagination[index].classList.add('swiper-pagination-bullet-active');
    }
    // Cambiar imagen de fondo
    if (mobileBg && mobileBgImages[index]) {
      mobileBg.style.backgroundImage = `url('${mobileBgImages[index]}')`;
    }
    // Texto oscuro en slides con fondo claro (solo desktop)
    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
      heroSection.classList.toggle('light-slide', isDesktop.matches && lightSlidesDesktop.includes(index));
    }
  }

  function nextSlide() {
    if (slides.length === 0) return;
    currentSlide = (currentSlide + 1) % 4; // Force only 4 slides
    showSlide(currentSlide);
  }

  function startSlider() {
    if (slideInterval) clearInterval(slideInterval);
    slideInterval = setInterval(nextSlide, 5000);
  }

  // Marcar el slider como inicializado y mostrar el primer slide de inmediato
  // (sin esperar 200ms) para no retrasar el pintado del hero en móvil.
  const heroSwiper = document.querySelector('.hero-swiper');
  if (heroSwiper) heroSwiper.classList.add('is-initialized');

  if (slides.length > 0) {
    showSlide(0);
    if (slides.length > 1) {
      startSlider();
    }
  }
});
</script>
