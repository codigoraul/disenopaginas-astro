---
import { city } from '../../data/reservas-online';
---
<section class="sec" id="testimonios">
  <div class="wrap">
    <h2 class="head2 rv">{city.testimonials.title}</h2>
    <p class="rv" style="margin:-1.6rem 0 2rem;color:var(--mut);max-width:60ch">{city.testimonials.sub}</p>
    <div class="tm">
      {city.testimonials.items.map((t, i) => (
        <figure class="tm__c rv" style={`--i:${i}`}>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
    <a class="tm__g rv" href="https://www.google.com/maps/search/?api=1&query=Disenopaginas+Padre+Las+Casas" target="_blank" rel="noopener noreferrer">
      <span class="tm__st" aria-hidden="true">★★★★★</span>
      <span><strong>5,0 en Google</strong> · Ver todas las opiniones de diseñopaginas</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
    </a>
  </div>
</section>
