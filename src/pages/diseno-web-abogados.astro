---
import Layout from '../layouts/Layout.astro';

const servicios = [{"icon": "world", "t": "Páginas Web Profesionales", "d": "Diseño elegante y profesional que transmite seriedad y confianza a sus potenciales clientes.", "li": ["Diseño corporativo", "Imagen de confianza", "Navegación intuitiva"]}, {"icon": "calendar-event", "t": "Agenda de Consultas", "d": "Permita que sus clientes agenden consultas jurídicas de forma fácil y profesional.", "li": ["Agenda online", "Confirmación automática", "Recordatorios"]}, {"icon": "search", "t": "SEO Legal", "d": "Posicionamiento en Google para aparecer cuando busquen \"abogado especialista\".", "li": ["Palabras clave legales", "SEO local", "Contenido optimizado"]}, {"icon": "news", "t": "Blog Jurídico", "d": "Sistema de blog para compartir artículos legales y posicionarse como experto.", "li": ["Gestión de contenido", "Artículos SEO", "Autoridad legal"]}, {"icon": "shield-lock", "t": "Seguridad y Privacidad", "d": "Máxima seguridad para proteger la información confidencial de sus clientes.", "li": ["SSL Premium", "Formularios seguros", "Respaldos automáticos"]}, {"icon": "users-group", "t": "Área de Clientes", "d": "Portal privado donde sus clientes pueden acceder a documentos y seguimiento de casos.", "li": ["Acceso privado", "Documentos seguros", "Estado de casos"]}];
const tipos = [{"icon": "users", "t": "Derecho Civil", "d": "Contratos, sucesiones, familia"}, {"icon": "briefcase", "t": "Derecho Laboral", "d": "Despidos, contratos laborales"}, {"icon": "gavel", "t": "Derecho Penal", "d": "Defensa criminal, delitos"}, {"icon": "building", "t": "Derecho Comercial", "d": "Empresas, sociedades"}];
const regiones = [{"n": "01", "t": "Norte", "d": "Arica, Iquique, Antofagasta, Calama, La Serena", "m": ["Arica", "Antofagasta", "La Serena"]}, {"n": "02", "t": "Centro", "d": "Santiago, Valparaíso, Viña del Mar, Rancagua, Concepción", "m": ["Santiago", "Viña del Mar", "Concepción"]}, {"n": "03", "t": "Sur", "d": "Temuco, Valdivia, Osorno, Puerto Montt y la Patagonia", "m": ["Temuco", "Valdivia", "Puerto Montt"]}];
const proyectos = [{"img": "bordoliabogados", "t": "Bordoli Abogados", "d": "Estudio jurídico", "u": "bordoliabogados.cl"}, {"img": "manriquezrivera", "t": "Manríquez Rivera", "d": "Abogados para empresas y personas", "u": "manriquezrivera.cl"}, {"img": "legaldatos", "t": "Legaldatos", "d": "Abogados", "u": "legaldatos.cl"}, {"img": "apurolegal", "t": "Apuro Legal", "d": "Páginas web para abogados", "u": "apurolegal.cl"}, {"img": "asesordeinsolvencia", "t": "Asesor de Insolvencia", "d": "Asesoría en insolvencia", "u": "asesordeinsolvencia.cl"}, {"img": "metaperitaje", "t": "Metaperitaje", "d": "Peritajes", "u": "metaperitaje.cl"}];
const razones = [{"icon": "award", "t": "Experiencia Legal", "d": "Conocemos las necesidades específicas del sector legal chileno."}, {"icon": "lock", "t": "Confidencialidad", "d": "Máxima seguridad y privacidad en el manejo de información."}, {"icon": "edit", "t": "Web Autoadministrable", "d": "Panel simple para publicar artículos, actualizar áreas de práctica y datos de contacto sin depender de un programador."}, {"icon": "bolt", "t": "Rápida, hecha en Astro JS", "d": "Sitios livianos que cargan en menos de 1 segundo, con mejor experiencia para el cliente y mejor posicionamiento en Google."}, {"icon": "users", "t": "Generación de Leads", "d": "Sitios optimizados para atraer y convertir potenciales clientes."}, {"icon": "headset", "t": "Soporte Especializado", "d": "Atención técnica que entiende el sector legal."}];
const faq = [{"q": "¿Cuánto cuesta una página web para un abogado o estudio jurídico?", "a": "Depende del alcance: un sitio con áreas de práctica, equipo y contacto parte en el rango de nuestras tarifas web, y los proyectos con blog, agenda online o área de clientes se cotizan a medida. Escríbenos y te enviamos una propuesta sin costo."}, {"q": "¿Cómo hago para aparecer en Google cuando buscan \"abogado\" en mi ciudad?", "a": "Combinamos un sitio rápido y bien estructurado con SEO local: ficha de Google Business Profile, páginas por área de práctica y textos con la ciudad y los servicios que ofrece. También ofrecemos posicionamiento web SEO si quiere destacar más."}, {"q": "¿Puedo publicar artículos jurídicos yo mismo?", "a": "Sí. Entregamos el sitio autoadministrable: puede publicar artículos, actualizar áreas de práctica y datos de contacto desde un panel simple, sin depender de un programador. Si prefiere, también nos encargamos de las actualizaciones."}, {"q": "¿Cómo se protege la información de mis clientes?", "a": "Instalamos certificado SSL, formularios seguros y respaldos automáticos, y podemos incluir política de privacidad y aviso de uso de datos. Si necesita un área privada de clientes, la diseñamos con acceso restringido."}, {"q": "¿Qué tan rápida será mi página web?", "a": "Construimos los sitios con Astro JS, un framework que entrega páginas muy livianas, y los optimizamos para que carguen en menos de 1 segundo. Esto mejora la experiencia de sus clientes y el posicionamiento en Google."}, {"q": "¿Trabajan con abogados de todo Chile?", "a": "Sí. Desarrollamos sitios para abogados y estudios jurídicos de todo el país, y nos coordinamos por WhatsApp, correo o videollamada."}, {"q": "¿Cuánto demora el proyecto?", "a": "Un sitio para estudio jurídico suele estar listo en pocas semanas, según la cantidad de secciones y de lo rápido que recibamos contenidos y fotografías. Te damos un plazo claro en la cotización."}];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const banda = ["Derecho civil", "Derecho laboral", "Derecho penal", "Derecho comercial", "Familia", "Inmobiliario", "Tributario", "Insolvencia"];
---

<Layout
  title="Diseño Web para Abogados Chile | Páginas Web Estudios Jurídicos"
  description="Especialistas en diseño web para abogados y estudios jurídicos en Chile. Páginas web profesionales que generan confianza y atraen nuevos clientes. ¡Consulta gratis!"
  keywords="diseño web abogados, páginas web estudios jurídicos, sitios web abogados Chile, marketing digital abogados, diseño web legal"
  navItems={[
    { label: "Servicios", href: "#servicios" },
    { label: "Áreas del derecho", href: "#empresas" },
    { label: "Proyectos", href: "#proyectos" },
    { label: "Por qué elegirnos", href: "#por-que" },
    { label: "Preguntas", href: "#faq" },
    { label: "Cotizar", href: "#contacto" },
  ]}
  breadcrumbs={[{ name: "Diseño Web para Abogados", url: "https://diseñopaginas.cl/diseno-web-abogados" }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="mn">
    <!-- HERO -->
    <section class="mn-hero" id="inicio">
      <video class="mn-hero__vid" autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src="/assets/videos/bg-abogados.mp4" type="video/mp4"></video><div class="mn-hero__ov"></div>
      <div class="mn-wrap mn-hero__in">
        <span class="mn-eyebrow">Especialistas en Sector Legal</span>
        <h1>Diseño Web para <em>Abogados y Estudios Jurídicos</em></h1>
        <p class="mn-lead">
          Creamos sitios web profesionales para abogados que transmiten confianza, credibilidad y atraen nuevos clientes. Más de 13 años especializados en el sector legal chileno.
        </p>
        <div class="mn-cta">
          <a href="#contacto" class="mn-btn mn-btn--cu">Consulta Gratuita <i class="ti ti-arrow-right"></i></a>
          <a href="#proyectos" class="mn-btn mn-btn--ghost">Ver Trabajos</a>
        </div>
        <ul class="mn-chips"><li><i class="ti ti-clock-check"></i> +13 años de experiencia</li><li><i class="ti ti-bolt"></i> Hecho en Astro JS · carga en menos de 1 s</li><li><i class="ti ti-edit"></i> Web autoadministrable</li></ul>
      </div>
    </section>

    <!-- CINTA -->
    <div class="mn-band" aria-hidden="true">
      <div class="mn-band__t">
        {[...banda, ...banda, ...banda].map(m => <span>{m}</span>)}
      </div>
    </div>

    <!-- SERVICIOS -->
    <section class="mn-sec" id="servicios">
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Servicios Web Especializados para Abogados</h2>
          <p>Soluciones digitales diseñadas específicamente para el sector legal</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {servicios.map((s, i) => (
            <article class="mn-card">
              <span class="mn-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="mn-ico"><i class={`ti ti-${s.icon}`}></i></div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <ul>{s.li.map(x => <li><i class="ti ti-check"></i>{x}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- TIPOS -->
    <section class="mn-sec mn-sec--dark" id="empresas">
      <div class="mn-wrap mn-split">
        <div class="mn-split__txt">
          <header class="mn-head mn-head--left">
            <h2>Especializaciones Legales</h2>
            <p>Creamos sitios web para todas las áreas del derecho</p>
          </header>
          <div class="mn-grid mn-grid--2">
            {tipos.map(t => (
              <div class="mn-tile">
                <i class={`ti ti-${t.icon}`}></i>
                <h3>{t.t}</h3>
                <p>{t.d}</p>
              </div>
            ))}
          </div>
        </div>
        <figure class="mn-shots"><img src="/assets/img/portafolio/bordoliabogados.webp" alt="Diseño web Bordoli Abogados" loading="lazy" width="480" height="285" /><img src="/assets/img/portafolio/manriquezrivera.webp" alt="Diseño web Manríquez Rivera Abogados" loading="lazy" width="480" height="285" /></figure>
      </div>
    </section>

    <!-- COBERTURA -->
    <section class="mn-sec" id="regiones">
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Abogados en Todo Chile</h2>
          <p>Trabajamos de forma remota con estudios jurídicos de todas las regiones</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {regiones.map(r => (
            <article class="mn-reg">
              <span class="mn-reg__n">{r.n}</span>
              <h3>{r.t}</h3>
              <p>{r.d}</p>
              <div class="mn-tags">{r.m.map(x => <span>{x}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROYECTOS -->
    <section class="mn-sec mn-sec--soft" id="proyectos">
      <span id="portafolio-abogados"></span>
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Proyectos Web para Abogados y Asesorías Legales</h2>
          <p>Sitios reales que hemos desarrollado para el rubro</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {proyectos.map(p => (
            <a class="mn-proj" href={`https://${p.u}`} target="_blank" rel="noopener noreferrer">
              <div class="mn-proj__img"><img src={`/assets/img/portafolio/${p.img}.webp`} alt={`Diseño web ${p.t}`} loading="lazy" width="480" height="285" /></div>
              <div class="mn-proj__t"><strong>{p.t}</strong><span>{p.d}</span><em>{p.u} <i class="ti ti-arrow-up-right"></i></em></div>
            </a>
          ))}
        </div>
        <p class="mn-more"><a href="/portafolio">Ver todo el portafolio <i class="ti ti-arrow-right"></i></a></p>
      </div>
    </section>

    <!-- POR QUÉ -->
    <section class="mn-sec" id="por-que">
      <div class="mn-wrap mn-split mn-split--rev">
        <figure class="mn-shots"><img src="/assets/img/portafolio/legaldatos.webp" alt="Diseño web Legaldatos" loading="lazy" width="480" height="285" /><img src="/assets/img/portafolio/apurolegal.webp" alt="Diseño web Apuro Legal" loading="lazy" width="480" height="285" /></figure>
        <div class="mn-split__txt">
          <header class="mn-head mn-head--left">
            <h2>¿Por qué elegir nuestros servicios para su estudio jurídico?</h2>
          </header>
          <div class="mn-list">
            {razones.map(r => (
              <div class="mn-li">
                <div class="mn-ico mn-ico--sm"><i class={`ti ti-${r.icon}`}></i></div>
                <div><h3>{r.t}</h3><p>{r.d}</p></div>
              </div>
            ))}
          </div>
          <p class="mn-xlink">¿Su asesoría es para empresas? Vea nuestro <a href="/">diseño web para pymes</a>.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mn-sec mn-sec--soft" id="faq">
      <div class="mn-wrap mn-wrap--narrow">
        <header class="mn-head">
          <h2>Preguntas frecuentes sobre diseño web para abogados</h2>
        </header>
        <div class="mn-faq">
          {faq.map(f => (
            <details class="mn-faq__i">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mn-final" id="contacto">
      <div class="mn-wrap">
        <h2>¿Listo para atraer más clientes con su nueva página web?</h2>
        <p>Déjenos sus datos y le escribimos por WhatsApp para una consulta gratuita</p>
        <form class="mn-form" id="mn-form" novalidate>
          <label class="mn-f"><span>Estudio o abogado</span><input type="text" name="empresa" autocomplete="organization" required placeholder="Nombre del estudio o abogado" /></label>
          <label class="mn-f"><span>Teléfono</span><input type="tel" name="fono" autocomplete="tel" inputmode="tel" required placeholder="+56 9 1234 5678" /></label>
          <label class="mn-f"><span>Correo</span><input type="email" name="correo" autocomplete="email" required placeholder="contacto@estudio.cl" /></label>
          <button type="submit" class="mn-btn mn-btn--cu"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
          <p class="mn-form__err" id="mn-form-err" role="alert" hidden>Complete nombre, teléfono y un correo válido.</p>
        </form>
        <div class="mn-cta mn-cta--c">
          <a href="/contacto" class="mn-btn mn-btn--ghost"><i class="ti ti-mail"></i> Formulario completo de contacto</a>
          <a href="tel:+56961765268" class="mn-btn mn-btn--ghost"><i class="ti ti-phone"></i> (+56) 9 61765268</a>
        </div>
      </div>
    </section>
  </div>

<script is:inline>
  (function(){
    var links=[].slice.call(document.querySelectorAll('#disenopaginasNav a.nav-link[href^="#"]')).filter(function(a){return a.getAttribute('href')!=='#contacto'});
    var map=links.map(function(a){return{a:a,el:document.querySelector(a.getAttribute('href'))}}).filter(function(x){return x.el});
    function upd(){var y=window.scrollY+140,cur=null;map.forEach(function(x){var t=x.el.getBoundingClientRect().top+window.scrollY;if(t<=y)cur=x});links.forEach(function(a){a.classList.toggle('on',!!cur&&cur.a===a)})}
    window.addEventListener('scroll',upd,{passive:true});upd();
    document.querySelectorAll('#disenopaginasNav a').forEach(function(a){a.addEventListener('click',function(){var c=document.getElementById('disenopaginasNav');if(c&&c.classList.contains('show'))c.classList.remove('show')})});
  })();
</script>
<script is:inline>
  (function(){
    var f=document.getElementById('mn-form');if(!f)return;
    f.addEventListener('submit',function(e){
      e.preventDefault();
      var v=function(n){return f.elements[n].value.trim()};
      var emp=v('empresa'),fono=v('fono'),mail=v('correo');
      var ok=emp.length>1&&fono.replace(/\D/g,'').length>=8&&/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail);
      ['empresa','fono','correo'].forEach(function(n){f.elements[n].classList.remove('bad')});
      if(!ok){if(emp.length<2)f.elements.empresa.classList.add('bad');if(fono.replace(/\D/g,'').length<8)f.elements.fono.classList.add('bad');if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail))f.elements.correo.classList.add('bad');document.getElementById('mn-form-err').hidden=false;return}
      document.getElementById('mn-form-err').hidden=true;
      var t='Hola, vengo de diseñopaginas.cl (página Abogados) y quiero una consulta gratuita.\nEstudio: '+emp+'\nTeléfono: '+fono+'\nCorreo: '+mail;
      window.open('https://api.whatsapp.com/send?phone=56961765268&text='+encodeURIComponent(t),'_blank','noopener');
    });
  })();
</script>
</Layout>

<style is:global>
  .mn{--ink:#12161D;--ink2:#1A2029;--ink3:#232B38;--cu:#C9A24B;--cu2:#EBD493;--bl:#447DE9;--tx:#1E2536;--mut:#5B6577;--line:#E3E7EE;--soft:#F5F7FA;font-family:'Inter',system-ui,sans-serif;color:var(--tx);background:#fff}
  .mn h1,.mn h2,.mn h3{font-family:'Sora','Outfit',sans-serif;margin:0}
  .mn-wrap{width:min(1180px,100% - 2rem);margin-inline:auto}
  .mn-wrap--narrow{width:min(860px,100% - 2rem)}


  html{scroll-behavior:smooth}
  .mn-hero,.mn-sec,.mn-final{scroll-margin-top:110px}
  #disenopaginasNav .nav-link.on{color:#C9A24B !important}

  /* FORMULARIO */
  .mn-form{display:grid;grid-template-columns:repeat(3,1fr) auto;gap:.8rem;max-width:62rem;margin:2rem auto 0;text-align:left;align-items:end}
  .mn-f{display:flex;flex-direction:column;gap:.35rem;font-size:.82rem;color:#C9D3E2;font-weight:500}
  .mn-f input{font:inherit;font-size:1rem;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.28);border-radius:12px;padding:.85rem 1rem;min-height:50px}
  .mn-f input::placeholder{color:#8B98AE}
  .mn-f input:focus{outline:2px solid #EBD493;outline-offset:1px;background:rgba(255,255,255,.12)}
  .mn-f input.bad{border-color:#ff7a7a}
  .mn-form .mn-btn{min-height:50px;justify-content:center;cursor:pointer;white-space:nowrap}
  .mn-form__err{grid-column:1/-1;margin:0 !important;color:#ffb4b4 !important;text-align:center;max-width:none !important}
  .mn-final .mn-cta{margin-top:1.4rem}
  @media (max-width:860px){.mn-form{grid-template-columns:1fr}}

  /* HERO */
  .mn-hero{position:relative;color:#fff;background:linear-gradient(90deg,rgba(18,22,29,.94) 0%,rgba(18,22,29,.78) 48%,rgba(18,22,29,.35) 100%),radial-gradient(60% 90% at 85% 20%,rgba(201,162,75,.22),transparent 70%),linear-gradient(160deg,#12161D,#232B38);padding:clamp(8.8rem,14vw,11rem) 0 clamp(3.5rem,8vw,6rem);overflow:hidden}
  .mn-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--cu),var(--cu2),transparent)}
  .mn-hero__in{position:relative}
  .mn-eyebrow{display:inline-block;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--cu2);padding:.45rem .9rem;border:1px solid rgba(235,212,147,.45);border-radius:99px;background:rgba(201,162,75,.1);margin-bottom:1.4rem}
  .mn-hero h1{font-size:clamp(2rem,5.4vw,3.6rem);line-height:1.08;font-weight:700;letter-spacing:-.01em;max-width:19ch;text-wrap:balance;color:#fff}
  .mn-hero h1 em{font-style:normal;color:var(--cu2)}
  .mn-lead{margin:1.4rem 0 0;max-width:40rem;font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.7;color:#E6EBF3;text-wrap:pretty}
  .mn-cta{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
  .mn-cta--c{justify-content:center}
  .mn-btn{display:inline-flex;align-items:center;gap:.55rem;padding:.95rem 1.6rem;border-radius:12px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid transparent;transition:transform .2s,box-shadow .2s,background .2s}
  .mn-btn:hover{transform:translateY(-2px)}
  .mn-btn--cu{background:linear-gradient(135deg,var(--cu2),var(--cu));color:#221A06;box-shadow:0 12px 26px -12px rgba(201,162,75,.7)}
  .mn-btn--cu:hover{color:#221A06;box-shadow:0 18px 32px -12px rgba(201,162,75,.85)}
  .mn-btn--ghost{background:rgba(255,255,255,.06);color:#fff;border-color:rgba(255,255,255,.35);backdrop-filter:blur(4px)}
  .mn-btn--ghost:hover{background:rgba(255,255,255,.14);color:#fff}
  .mn-chips{list-style:none;padding:0;margin:2.4rem 0 0;display:flex;flex-wrap:wrap;gap:.7rem}
  .mn-chips li{display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1rem;border-radius:99px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);font-size:.9rem;color:#EAF0F8}
  .mn-chips i{color:var(--cu2);font-size:1.1rem}

  /* CINTA */
  .mn-band{background:var(--ink);overflow:hidden;border-bottom:1px solid #1E2531}
  .mn-band__t{display:flex;gap:3rem;width:max-content;padding:1rem 0;animation:mn-slide 38s linear infinite}
  .mn-band__t span{font-family:'Sora',sans-serif;font-size:.85rem;letter-spacing:.22em;text-transform:uppercase;color:#7C8AA3;white-space:nowrap}
  .mn-band__t span::after{content:"◆";margin-left:3rem;color:var(--cu);font-size:.6rem;vertical-align:middle}
  @keyframes mn-slide{to{transform:translateX(-33.333%)}}
  @media (prefers-reduced-motion:reduce){.mn-band__t{animation:none}}

  /* SECCIONES */
  .mn-sec{padding:clamp(3.2rem,7vw,5.5rem) 0}
  .mn-sec--soft{background:var(--soft)}
  .mn-sec--dark{background:var(--ink2);color:#DCE3EE}
  .mn-head{text-align:center;max-width:46rem;margin:0 auto clamp(1.8rem,4.5vw,2.8rem)}
  .mn-head--left{text-align:left;margin-inline:0}
  .mn-head h2{font-size:clamp(1.55rem,3.4vw,2.2rem);line-height:1.22;font-weight:700;letter-spacing:-.005em;text-wrap:balance;color:var(--tx)}
  .mn-head p{margin:.8rem 0 0;color:var(--mut);font-size:1.05rem;text-wrap:pretty}
  .mn-sec--dark .mn-head h2{color:#fff}
