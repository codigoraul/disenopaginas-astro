---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPosts } from '../lib/wordpress.js';

// Artículos estáticos que viven en src/pages/blog/*.astro.
// Solo se muestran como respaldo si WordPress no responde.
const staticPosts = [
   {
      title: '¿Cuánto Cuesta una Página Web en Chile 2026? Precios Reales',
      url: '/blog/cuanto-cuesta-pagina-web-chile',
      image: '/assets/img/blog/cuanto-cuesta-pagina-web-chile/portada.webp',
      imageAlt: 'Cuánto cuesta una página web en Chile 2026',
      category: 'Precios',
      dateFormatted: '12 Junio 2026',
   },
   {
      title: 'IA en Diseño Web: Por Qué Necesitas un Experto Humano',
      url: '/blog/ia-diseno-web-experto-humano',
      image: '/assets/img/blog/ia-diseno-web-experto-humano/portada.webp',
      imageAlt: 'IA en Diseño Web',
      category: 'Diseño Web',
      dateFormatted: '17 Abril 2026',
   },
   {
      title: 'Diseño Web Híbrido: WordPress Headless con Astro.js',
      url: '/blog/disenoweb-hibrido-wordpress-headless-astro',
      image: '/assets/img/blog/wordpress-headless-astro/portada.webp',
      imageAlt: 'Diseño Web Híbrido',
      category: 'Diseño Web',
      dateFormatted: '12 Febrero 2025',
   },
   {
      title: 'SEO y Estructura Web 2025: Optimización para Empresas',
      url: '/blog/tendencias-web-ia-2025',
      image: '/assets/img/blog/tendencias-web-ia-2025/portada.jpg',
      imageAlt: 'SEO y Estructura Web',
      category: 'Diseño Web',
      dateFormatted: '15 Enero 2025',
   },
   {
      title: 'Guía completa de SEO para principiantes',
      url: '/blog/guia-seo-principiantes',
      image: '/assets/img/blog/guia-seo-principiantes/portada.webp',
      imageAlt: 'Guía SEO',
      category: 'SEO',
      dateFormatted: '12 Enero 2025',
   },
];

let wpPosts = [];

try {
   wpPosts = await getPosts();
} catch (e) {
   console.error(
      '[blog] WordPress no disponible, se muestran los artículos estáticos:',
      e.message
   );
}

// Si WordPress responde con entradas, manda WordPress.
// Si falla o viene vacío, caemos a los artículos estáticos.
const usingWordPress = wpPosts.length > 0;

const posts = usingWordPress
   ? wpPosts.map((post) => ({
        title: post.title,
        url: `/blog/${post.slug}`,
        image: post.image,
        imageAlt: post.imageAlt,
        category: post.category,
        dateFormatted: post.dateFormatted,
     }))
   : staticPosts;
---

<Layout title="Blog - Diseño Web y Tecnología">
   <!-- Breadcrumb -->
   <Breadcrumb title="Blog" currentPage="Blog Grid" />

   <!-- Blog Section -->
   <div class="blog-section bg-white">
      <div class="container">
         <!-- Section Heading -->
         <div class="row">
            <div class="col-12 text-center mb-5">
               <h2 class="section-title">Artículos Destacados</h2>
            </div>
         </div>

         <div class="row g-4 g-xxl-5 justify-content-center">
            {posts.map((post, i) => (
               <div class="col-12 col-sm-6 col-lg-4">
                  <div
                     class="blog-card wow fadeInUp"
                     data-wow-duration="1000ms"
                     data-wow-delay={`${300 + i * 100}ms`}
                  >
                     <!-- Post Image -->
                     <div class="post-img">
                        {post.image && (
                           <a href={post.url}>
                              <img loading="lazy" src={post.image} alt={post.imageAlt} />
                           </a>
                        )}
                     </div>
                     <!-- Post Body -->
                     <div class="post-body">
                        <div class="blog-meta flex-wrap d-flex align-items-center gap-2">
                           <span class="cat">{post.category}</span>
                           <div class="dot"></div>
                           <span>{post.dateFormatted}</span>
                        </div>
                        <a class="post-title h4" href={post.url}>{post.title}</a>
                        <a class="read-more-btn" href={post.url}>
                           Leer más <i class="ti ti-arrow-right"></i>
                        </a>
                     </div>
                  </div>
               </div>
            ))}
         </div>
      </div>

      <!-- Divider -->
      <div class="divider"></div>
   </div>
</Layout>

<style>
   .blog-section {
      padding: 80px 0;
   }

   .section-title {
      font-size: 42px;
      font-weight: 700;
      color: #333;
      margin-bottom: 15px;
   }

   .blog-card {
      background: #fff;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
      height: 100%;
   }

   .blog-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
   }

   .post-img {
      position: relative;
      overflow: hidden;
   }

   .post-img img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      transition: transform 0.3s ease;
   }

   .blog-card:hover .post-img img {
      transform: scale(1.05);
   }

   .post-body {
      padding: 25px;
   }

   .blog-meta {
      margin-bottom: 15px;
      font-size: 14px;
      color: #666;
   }

   .blog-meta .cat {
      color: var(--primary-color);
      font-weight: 500;
   }

   .dot {
      width: 4px;
      height: 4px;
      background: #666;
      border-radius: 50%;
   }

   .post-title {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.4;
      margin-bottom: 15px;
      color: #333;
      text-decoration: none;
      display: block;
   }

   .post-title:hover {
      color: var(--primary-color);
   }

   .read-more-btn {
      color: var(--primary-color);
      text-decoration: none;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: gap 0.3s ease;
   }

   .read-more-btn:hover {
      gap: 10px;
   }
</style>
