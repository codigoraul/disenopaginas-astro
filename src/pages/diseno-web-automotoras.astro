---
import Layout from '../layouts/Layout.astro';

const servicios = [{"icon": "list-search", "t": "Catálogo de vehículos con filtros", "d": "Buscador por marca, modelo, año, precio, kilometraje, transmisión y combustible. Tus clientes encuentran el auto que buscan en segundos, desde cualquier dispositivo.", "li": ["Filtros por marca y precio", "Año, km y combustible", "Se ve perfecto en celular"]}, {"icon": "car", "t": "Ficha por vehículo optimizada para SEO", "d": "Cada auto tiene su propia URL con galería de fotos, características técnicas, precio y estado. Google indexa cada ficha y tu automotora aparece cuando buscan ese modelo.", "li": ["Una URL por vehículo", "Galería de fotos", "Datos estructurados"]}, {"icon": "brand-whatsapp", "t": "Cotización y reservas por WhatsApp", "d": "Botón en cada vehículo que abre WhatsApp con el mensaje listo: modelo, año, precio o fechas de arriendo. Menos fricción, más consultas y reservas reales.", "li": ["Mensaje con el modelo listo", "Reserva con fechas", "Menos pasos, más consultas"]}, {"icon": "calculator", "t": "Simulador de financiamiento", "d": "Calculadora de cuotas con pie y plazo configurable para que el cliente sepa cuánto pagaría al mes antes de escribirte. Aumenta la intención de compra.", "li": ["Pie y plazo configurables", "Cuota mensual estimada", "Más consultas calificadas"]}, {"icon": "arrows-exchange", "t": "Formulario de tasación y parte de pago", "d": "Recibe solicitudes de tasación de autos usados con fotos y datos del vehículo. Ideal para automotoras que compran, consignan o reciben en parte de pago.", "li": ["Fotos y datos del auto", "Aviso a tu correo o WhatsApp", "Consignación y compra"]}, {"icon": "settings", "t": "Panel para administrar tu stock", "d": "Publica, edita o marca como vendido cada vehículo desde un panel simple, sin depender de nadie. Puedes cargar autos desde el celular en minutos.", "li": ["Publica y marca como vendido", "Carga desde el celular", "Capacitación incluida"]}];
const tipos = [{"icon": "building-store", "t": "Automotoras de usados", "d": "Stock completo con fotos, precio y financiamiento, y consultas calificadas por WhatsApp"}, {"icon": "building-skyscraper", "t": "Concesionarios y seminuevos", "d": "Catálogo por marca, servicio técnico, repuestos y test drive"}, {"icon": "file-invoice", "t": "Consignatarias y compraventa", "d": "Formulario de consignación y tasación online para captar vehículos"}, {"icon": "key", "t": "Rent a car y arriendo", "d": "Flota con tarifa diaria, disponibilidad por fechas y reserva online"}, {"icon": "truck", "t": "Camionetas, motos y maquinaria", "d": "Catálogos especializados para vehículos comerciales, camiones y maquinaria pesada"}];
const regiones = [{"n": "01", "t": "SEO local para tu ciudad", "d": "Optimizamos tu web para búsquedas como \"automotora en Temuco\", \"rent a car en Puerto Montt\" o \"autos usados en Santiago\", integrada con tu Perfil de Empresa en Google.", "m": ["Automotora en tu ciudad", "Rent a car", "Autos usados"]}, {"n": "02", "t": "Una URL por vehículo", "d": "Cada auto publicado es una página indexable con título, descripción y datos estructurados de vehículo (schema.org), para aparecer cuando buscan ese modelo.", "m": ["schema.org", "Ficha indexable", "Search Console"]}, {"n": "03", "t": "Velocidad y 100% móvil", "d": "Sitio estático hecho en Astro JS, ultrarrápido y con imágenes WebP. Más del 80% de quienes buscan un auto lo hacen desde el teléfono, y tu catálogo funciona perfecto en cualquier pantalla.", "m": ["Core Web Vitals", "WebP", "Mobile first"]}];
const proyectos = [{"img": "auto-demo", "t": "Sitio de muestra · Automotora", "d": "Catálogo, filtros y cotización por WhatsApp", "u": "disenopaginas.cl/automotora/"}, {"img": "nelparts", "t": "Nelparts", "d": "Catálogo web de repuestos para camiones", "u": "nelparts.cl"}, {"img": "hemmaquinaria", "t": "HEM Maquinaria", "d": "Arriendo de equipos y maquinaria", "u": "hemmaquinaria.cl"}];
const razones = [{"icon": "award", "t": "13+ años de experiencia", "d": "Diseñamos sitios web para negocios de todo Chile con foco en que vendan y se posicionen en Google."}, {"icon": "settings", "t": "Tú administras tu stock", "d": "Panel simple para publicar, editar o marcar como vendido cada vehículo, incluso desde el celular. Te capacitamos al entregar."}, {"icon": "bolt", "t": "Rápido, hecho en Astro JS", "d": "Carga en menos de 1 segundo, algo que Google premia y que tus clientes agradecen al comparar autos desde el teléfono."}, {"icon": "map-pin", "t": "SEO local desde el día uno", "d": "Textos con las palabras clave de tu ciudad y tipo de vehículo, conectados a Search Console y a tu Perfil de Empresa."}];
const faq = [{"q": "¿Cuánto cuesta una página web para una automotora?", "a": "Depende del tamaño del catálogo, las funcionalidades (simulador de crédito, tasación, panel de administración) y si necesitas integraciones. Cotizamos sin costo según lo que tu automotora necesita; escríbenos por WhatsApp y te enviamos una propuesta clara en menos de 24 horas."}, {"q": "¿Puedo subir y editar los vehículos yo mismo?", "a": "Sí. Entregamos un panel de administración simple donde publicas autos con fotos, precio y características, los marcas como vendidos o reservados y actualizas precios en minutos, incluso desde el celular. Te capacitamos al entregar el sitio."}, {"q": "¿La web sirve para vender autos usados y nuevos?", "a": "Sí. El catálogo se adapta a automotoras de usados, concesionarios de vehículos nuevos, seminuevos, consignatarias, rent a car y venta de motos, camionetas o maquinaria. Los filtros y las fichas se configuran según tu tipo de stock."}, {"q": "¿Sirve para un rent a car o arriendo de vehículos?", "a": "Sí. Para rent a car configuramos el catálogo como flota: tarifa diaria, categoría (económico, SUV, camioneta, van), requisitos de arriendo y un formulario de reserva con fechas de retiro y devolución que llega a tu WhatsApp o correo. Es ideal para rent a car en ciudades turísticas y aeropuertos."}, {"q": "¿Cuánto demora el desarrollo del sitio web?", "a": "Una landing page para automotora está lista en 7 a 10 días hábiles. Un sitio completo con catálogo, panel de administración y simulador de financiamiento toma entre 3 y 5 semanas, según la cantidad de vehículos iniciales y el contenido que tengamos disponible."}, {"q": "¿Cómo ayuda el sitio a aparecer en Google?", "a": "Cada vehículo tiene su propia página indexable con datos estructurados, redactamos textos con las palabras clave de tu ciudad y tipo de vehículo, optimizamos la velocidad y conectamos el sitio con Google Search Console y tu Perfil de Empresa. Además puedes complementar con campañas de Google Ads para resultados inmediatos."}, {"q": "¿Incluye hosting, dominio y mantenimiento?", "a": "Te asesoramos con el dominio .cl y el hosting, y podemos administrarlos por ti. También ofrecemos planes de mantenimiento mensual para actualizaciones, respaldos y soporte, de modo que tu web siempre esté online y segura."}];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const banda = ["Catálogo de autos", "Filtros por marca y precio", "Ficha por vehículo", "Cotización por WhatsApp", "Simulador de crédito", "Tasación online", "Reservas rent a car", "SEO local"];
---

<Layout
  title="Diseño Web para Automotoras y Rent a Car en Chile | Catálogo de Vehículos Online"
  description="Diseño de páginas web para automotoras, rent a car y venta de vehículos en Chile: catálogo de autos con filtros, fichas por vehículo, reservas y cotización por WhatsApp, simulador de financiamiento y SEO local para aparecer en Google. Cotización gratis."
  keywords="diseño web automotoras, página web automotora, diseño web rent a car, página web arriendo de vehículos, sitio web venta de vehículos, catálogo de autos online, plataforma venta de autos usados chile, diseño web concesionarios, web para compraventa de autos, reservas online rent a car"
  navItems={[
    { label: "Funciones", href: "#servicios" },
    { label: "Rubros", href: "#empresas" },
    { label: "SEO", href: "#regiones" },
    { label: "Muestras", href: "#proyectos" },
    { label: "Nosotros", href: "#por-que" },
    { label: "Preguntas", href: "#faq" },
    { label: "Cotizar", href: "#contacto" },
  ]}
  breadcrumbs={[{ name: "Diseño Web para Automotoras y Rent a Car", url: "https://diseñopaginas.cl/diseno-web-automotoras" }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div class="mn">
    <!-- HERO -->
    <section class="mn-hero" id="inicio">
      
      <div class="mn-wrap mn-hero__in">
        <span class="mn-eyebrow">Sitios web para automotoras y rent a car</span>
        <h1>Diseño Web para <em>Automotoras, Rent a Car y Venta de Vehículos</em></h1>
        <p class="mn-lead">
          Creamos la página web de tu automotora o rent a car con catálogo de vehículos, filtros por marca, modelo y precio, reservas y contacto directo por WhatsApp. Diseñada para vender o arrendar autos y aparecer en Google. Autoadministrable, hecha en Astro JS y con carga en menos de 1 segundo.
        </p>
        <div class="mn-cta">
          <a href="#contacto" class="mn-btn mn-btn--cu">Consulta Gratuita <i class="ti ti-arrow-right"></i></a>
          <a href="#proyectos" class="mn-btn mn-btn--ghost">Ver Trabajos</a>
        </div>
        <ul class="mn-chips"><li><i class="ti ti-clock-check"></i> +13 años de experiencia</li><li><i class="ti ti-bolt"></i> Hecho en Astro JS · carga en menos de 1 s</li><li><i class="ti ti-edit"></i> Web autoadministrable</li></ul>
      </div>
    </section>

    <!-- CINTA -->
    <div class="mn-band" aria-hidden="true">
      <div class="mn-band__t">
        {[...banda, ...banda, ...banda].map(m => <span>{m}</span>)}
      </div>
    </div>

    <!-- SERVICIOS -->
    <section class="mn-sec" id="servicios">
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Qué incluye el sitio web para tu automotora</h2>
          <p>Todo lo necesario para mostrar tu stock, recibir consultas y vender más desde tu propia web</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {servicios.map((s, i) => (
            <article class="mn-card">
              <span class="mn-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="mn-ico"><i class={`ti ti-${s.icon}`}></i></div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <ul>{s.li.map(x => <li><i class="ti ti-check"></i>{x}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- TIPOS -->
    <section class="mn-sec mn-sec--dark" id="empresas">
      <div class="mn-wrap mn-split">
        <div class="mn-split__txt">
          <header class="mn-head mn-head--left">
            <h2>Diseño web para todo negocio automotriz</h2>
            <p>Adaptamos el catálogo, los filtros y las fichas al tipo de vehículo y de negocio que tienes</p>
          </header>
          <div class="mn-grid mn-grid--2">
            {tipos.map(t => (
              <div class="mn-tile">
                <i class={`ti ti-${t.icon}`}></i>
                <h3>{t.t}</h3>
                <p>{t.d}</p>
              </div>
            ))}
          </div>
        </div>
        <figure class="mn-photo"><img src="/assets/img/automotoras/foto-entrega-llaves.webp" alt="Entrega de llaves de un vehículo en una automotora" loading="lazy" width="900" height="600" /></figure>
      </div>
    </section>

    <!-- COBERTURA -->
    <section class="mn-sec" id="regiones">
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>SEO local: que te encuentren cuando buscan un auto en tu ciudad</h2>
          <p>Tu sitio no solo se ve bien: está preparado para posicionar tu automotora en Google</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {regiones.map(r => (
            <article class="mn-reg">
              <span class="mn-reg__n">{r.n}</span>
              <h3>{r.t}</h3>
              <p>{r.d}</p>
              <div class="mn-tags">{r.m.map(x => <span>{x}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROYECTOS -->
    <section class="mn-sec mn-sec--soft" id="proyectos">
      <span id="muestras"></span>
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Así se ve un sitio web para automotoras hecho por nosotros</h2>
          <p>Sitios reales que hemos desarrollado para el rubro</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {proyectos.map(p => (
            <a class="mn-proj" href={`https://${p.u}`} target="_blank" rel="noopener noreferrer">
              <div class="mn-proj__img"><img src={`/assets/img/portafolio/${p.img}.webp`} alt={`Diseño web ${p.t}`} loading="lazy" width="480" height="285" /></div>
              <div class="mn-proj__t"><strong>{p.t}</strong><span>{p.d}</span><em>{p.u} <i class="ti ti-arrow-up-right"></i></em></div>
            </a>
          ))}
        </div>
        <p class="mn-more"><a href="/portafolio">Ver todo el portafolio <i class="ti ti-arrow-right"></i></a></p>
      </div>
    </section>

    <!-- POR QUÉ -->
    <section class="mn-sec" id="por-que">
      <div class="mn-wrap mn-split mn-split--rev">
        <figure class="mn-photo mn-photo--tall"><img src="/assets/img/automotoras/foto-catalogo-responsive.webp" alt="Catálogo de vehículos online visto en computador, tablet y celular" loading="lazy" width="900" height="575" /></figure>
        <div class="mn-split__txt">
          <header class="mn-head mn-head--left">
            <h2>¿Por qué elegirnos para el sitio de tu automotora?</h2>
          </header>
          <div class="mn-list">
            {razones.map(r => (
              <div class="mn-li">
                <div class="mn-ico mn-ico--sm"><i class={`ti ti-${r.icon}`}></i></div>
                <div><h3>{r.t}</h3><p>{r.d}</p></div>
              </div>
            ))}
          </div>
          <p class="mn-xlink">¿Tu negocio es otro rubro? Mira nuestro <a href="/">diseño web para pymes</a> o la <a href="/productos-online">tienda online para vender productos</a>.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mn-sec mn-sec--soft" id="faq">
      <div class="mn-wrap mn-wrap--narrow">
        <header class="mn-head">
          <h2>Preguntas frecuentes sobre diseño web para automotoras y rent a car</h2>
        </header>
        <div class="mn-faq">
          {faq.map(f => (
            <details class="mn-faq__i">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mn-final" id="contacto">
      <div class="mn-wrap">
        <h2>¿Listo para vender más vehículos desde tu propia web?</h2>
        <p>Déjenos sus datos y le escribimos por WhatsApp para una consulta gratuita</p>
        <form class="mn-form" id="mn-form" novalidate>
          <label class="mn-f"><span>Automotora o rent a car</span><input type="text" name="empresa" autocomplete="organization" required placeholder="Nombre de tu automotora o rent a car" /></label>
          <label class="mn-f"><span>Teléfono</span><input type="tel" name="fono" autocomplete="tel" inputmode="tel" required placeholder="+56 9 1234 5678" /></label>
          <label class="mn-f"><span>Correo</span><input type="email" name="correo" autocomplete="email" required placeholder="contacto@automotora.cl" /></label>
          <button type="submit" class="mn-btn mn-btn--cu"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
          <p class="mn-form__err" id="mn-form-err" role="alert" hidden>Complete nombre, teléfono y un correo válido.</p>
        </form>
        <div class="mn-cta mn-cta--c">
          <a href="/contacto" class="mn-btn mn-btn--ghost"><i class="ti ti-mail"></i> Formulario completo de contacto</a>
          <a href="tel:+56961765268" class="mn-btn mn-btn--ghost"><i class="ti ti-phone"></i> (+56) 9 61765268</a>
        </div>
      </div>
    </section>
  </div>

<script is:inline>
  (function(){
    var links=[].slice.call(document.querySelectorAll('#disenopaginasNav a.nav-link[href^="#"]')).filter(function(a){return a.getAttribute('href')!=='#contacto'});
    var map=links.map(function(a){return{a:a,el:document.querySelector(a.getAttribute('href'))}}).filter(function(x){return x.el});
    function upd(){var y=window.scrollY+140,cur=null;map.forEach(function(x){var t=x.el.getBoundingClientRect().top+window.scrollY;if(t<=y)cur=x});links.forEach(function(a){a.classList.toggle('on',!!cur&&cur.a===a)})}
    window.addEventListener('scroll',upd,{passive:true});upd();
    document.querySelectorAll('#disenopaginasNav a').forEach(function(a){a.addEventListener('click',function(){var c=document.getElementById('disenopaginasNav');if(c&&c.classList.contains('show'))c.classList.remove('show')})});
  })();
</script>
<script is:inline>
  (function(){
    var f=document.getElementById('mn-form');if(!f)return;
    f.addEventListener('submit',function(e){
      e.preventDefault();
      var v=function(n){return f.elements[n].value.trim()};
      var emp=v('empresa'),fono=v('fono'),mail=v('correo');
      var ok=emp.length>1&&fono.replace(/\D/g,'').length>=8&&/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail);
      ['empresa','fono','correo'].forEach(function(n){f.elements[n].classList.remove('bad')});
      if(!ok){if(emp.length<2)f.elements.empresa.classList.add('bad');if(fono.replace(/\D/g,'').length<8)f.elements.fono.classList.add('bad');if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail))f.elements.correo.classList.add('bad');document.getElementById('mn-form-err').hidden=false;return}
      document.getElementById('mn-form-err').hidden=true;
      var t='Hola, vengo de diseñopaginas.cl (página Automotoras y Rent a Car) y quiero una consulta gratuita.\nAutomotora: '+emp+'\nTeléfono: '+fono+'\nCorreo: '+mail;
      window.open('https://api.whatsapp.com/send?phone=56961765268&text='+encodeURIComponent(t),'_blank','noopener');
    });
  })();
</script>
</Layout>

<style is:global>
  .mn{--ink:#050506;--ink2:#0D0D0F;--ink3:#141417;--cu:#E10600;--cu2:#FF3B30;--bl:#447DE9;--tx:#1E2536;--mut:#5B6577;--line:#E3E7EE;--soft:#F5F7FA;font-family:'Inter',system-ui,sans-serif;color:var(--tx);background:#fff}
  .mn h1,.mn h2,.mn h3{font-family:'Sora','Outfit',sans-serif;margin:0}
  .mn-wrap{width:min(1180px,100% - 2rem);margin-inline:auto}
  .mn-wrap--narrow{width:min(860px,100% - 2rem)}


  html{scroll-behavior:smooth}
  .mn-hero,.mn-sec,.mn-final{scroll-margin-top:110px}
  #disenopaginasNav .nav-link.on{color:#E10600 !important}

  /* FORMULARIO */
  .mn-form{display:grid;grid-template-columns:repeat(3,1fr) auto;gap:.8rem;max-width:62rem;margin:2rem auto 0;text-align:left;align-items:end}
  .mn-f{display:flex;flex-direction:column;gap:.35rem;font-size:.82rem;color:#C9D3E2;font-weight:500}
  .mn-f input{font:inherit;font-size:1rem;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.28);border-radius:12px;padding:.85rem 1rem;min-height:50px}
  .mn-f input::placeholder{color:#8B98AE}
  .mn-f input:focus{outline:2px solid #FF3B30;outline-offset:1px;background:rgba(255,255,255,.12)}
  .mn-f input.bad{border-color:#ff7a7a}
  .mn-form .mn-btn{min-height:50px;justify-content:center;cursor:pointer;white-space:nowrap}
  .mn-form__err{grid-column:1/-1;margin:0 !important;color:#ffb4b4 !important;text-align:center;max-width:none !important}
  .mn-final .mn-cta{margin-top:1.4rem}
  @media (max-width:860px){.mn-form{grid-template-columns:1fr}}

  /* HERO */
  .mn-hero{position:relative;color:#fff;background:linear-gradient(90deg,rgba(5,5,6,.94) 0%,rgba(5,5,6,.78) 48%,rgba(5,5,6,.35) 100%),url('/assets/img/automotoras/hero-automotoras.webp') center/cover no-repeat;padding:clamp(8.8rem,14vw,11rem) 0 clamp(3.5rem,8vw,6rem);overflow:hidden}
  .mn-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--cu),var(--cu2),transparent)}
  .mn-hero__in{position:relative}
  .mn-eyebrow{display:inline-block;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--cu2);padding:.45rem .9rem;border:1px solid rgba(255,59,48,.45);border-radius:99px;background:rgba(225,6,0,.1);margin-bottom:1.4rem}
  .mn-hero h1{font-size:clamp(2rem,5.4vw,3.6rem);line-height:1.08;font-weight:700;letter-spacing:-.01em;max-width:19ch;text-wrap:balance;color:#fff}
  .mn-hero h1 em{font-style:normal;color:var(--cu2)}
  .mn-lead{margin:1.4rem 0 0;max-width:40rem;font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.7;color:#E6EBF3;text-wrap:pretty}
  .mn-cta{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
  .mn-cta--c{justify-content:center}
  .mn-btn{display:inline-flex;align-items:center;gap:.55rem;padding:.95rem 1.6rem;border-radius:12px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid transparent;transition:transform .2s,box-shadow .2s,background .2s}
  .mn-btn:hover{transform:translateY(-2px)}
  .mn-btn--cu{background:linear-gradient(135deg,var(--cu2),var(--cu));color:#FFFFFF;box-shadow:0 12px 26px -12px rgba(225,6,0,.7)}
  .mn-btn--cu:hover{color:#FFFFFF;box-shadow:0 18px 32px -12px rgba(225,6,0,.85)}
  .mn-btn--ghost{background:rgba(255,255,255,.06);color:#fff;border-color:rgba(255,255,255,.35);backdrop-filter:blur(4px)}
  .mn-btn--ghost:hover{background:rgba(255,255,255,.14);color:#fff}
  .mn-chips{list-style:none;padding:0;margin:2.4rem 0 0;display:flex;flex-wrap:wrap;gap:.7rem}
  .mn-chips li{display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1rem;border-radius:99px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);font-size:.9rem;color:#EAF0F8}
  .mn-chips i{color:var(--cu2);font-size:1.1rem}

  /* CINTA */
