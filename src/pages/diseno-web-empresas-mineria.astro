---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const servicios = [
  { icon: 'building-factory', t: 'Sitios Web Corporativos', d: 'Diseño profesional que refleja la solidez y experiencia de su empresa minera.', li: ['Imagen corporativa', 'Diseño industrial', 'Navegación profesional'] },
  { icon: 'certificate', t: 'Certificaciones y Normas', d: 'Destacamos sus certificaciones ISO, normas de seguridad y estándares mineros.', li: ['ISO 9001, 14001, 45001', 'Normas de seguridad', 'Acreditaciones'] },
  { icon: 'users', t: 'Portal de Proveedores', d: 'Área privada para proveedores con documentos, licitaciones y procesos.', li: ['Acceso restringido', 'Documentos seguros', 'Proceso de registro'] },
  { icon: 'leaf', t: 'Sustentabilidad', d: 'Secciones dedicadas a mostrar sus compromisos ambientales y sociales.', li: ['Reportes ambientales', 'Responsabilidad social', 'Proyectos comunitarios'] },
  { icon: 'shield-lock', t: 'Seguridad Avanzada', d: 'Máxima seguridad para proteger información sensible y corporativa.', li: ['SSL Premium', 'Firewall avanzado', 'Backup diario'] },
  { icon: 'briefcase', t: 'Portal de Empleos', d: 'Sistema para publicar ofertas laborales y recibir postulaciones del sector.', li: ['Ofertas laborales', 'CV online', 'Filtros especializados'] },
];
const tipos = [
  { icon: 'mountain', t: 'Mineras', d: 'Empresas extractivas, faenas mineras' },
  { icon: 'tools', t: 'Contratistas', d: 'Servicios especializados, mantención' },
  { icon: 'truck', t: 'Proveedores', d: 'Equipos, insumos, tecnología' },
  { icon: 'flask', t: 'Laboratorios', d: 'Análisis, ensayos, certificación' },
];
const regiones = [
  { n: '01', t: 'Norte Grande', d: 'Arica, Tarapacá, Antofagasta', m: ['Cobre', 'Litio', 'Oro'] },
  { n: '02', t: 'Norte Chico', d: 'Atacama, Coquimbo', m: ['Hierro', 'Cobre', 'Oro'] },
  { n: '03', t: 'Centro Sur', d: "O'Higgins, Maule, Biobío", m: ['Cobre', 'Carbón'] },
];
const proyectos = [
  { img: 'emcl', t: 'Estándares Mineros Chile', d: 'Control de calidad minero', u: 'emcl.cl' },
  { img: 'wps', t: 'WPS Pipelines', d: 'Tuberías de pipeline y estaciones', u: 'wps.cl' },
  { img: 'hemmaquinaria', t: 'HEM Maquinaria', d: 'Arriendo de camiones y maquinaria', u: 'hemmaquinaria.cl' },
];
const razones = [
  { icon: 'shield-check', t: 'Experiencia Sectorial', d: 'Conocemos las necesidades específicas del sector minero chileno.' },
  { icon: 'lock', t: 'Seguridad Corporativa', d: 'Máximos estándares de seguridad para información sensible.' },
  { icon: 'award', t: 'Imagen Profesional', d: 'Sitios que proyectan solidez y confianza corporativa.' },
  { icon: 'headset', t: 'Soporte Especializado', d: 'Atención técnica que comprende el sector minero.' },
];
const faq = [
  { q: '¿Cuánto cuesta una página web para una empresa minera o contratista?', a: 'Depende del alcance: un sitio corporativo simple parte en el rango de nuestras tarifas web, y los proyectos con portal de proveedores, portal de empleos o área privada se cotizan a medida. Escríbenos y te enviamos una propuesta sin costo.' },
  { q: '¿Pueden mostrar nuestras certificaciones ISO y normas de seguridad?', a: 'Sí. Diseñamos secciones dedicadas a certificaciones (ISO 9001, 14001, 45001), políticas de seguridad, acreditaciones y reportes, de forma que sean fáciles de encontrar para mandantes y auditores.' },
  { q: '¿Se puede crear un portal privado para proveedores?', a: 'Sí. Implementamos áreas con acceso restringido para documentos, procesos de registro y licitaciones, con foco en la seguridad de la información.' },
  { q: '¿Trabajan con empresas de todo Chile, no solo del norte?', a: 'Sí. Atendemos empresas mineras, contratistas, proveedores y laboratorios de todo el país, desde Arica hasta el Biobío, y nos coordinamos por WhatsApp, correo o videollamada.' },
  { q: '¿El sitio quedará optimizado para aparecer en Google?', a: 'Construimos cada sitio con SEO técnico desde el inicio: carga rápida, estructura ordenada y textos pensados para búsquedas como "diseño web minería". También ofrecemos posicionamiento web SEO si quieres destacar más.' },
  { q: '¿Cuánto demora el proyecto?', a: 'Un sitio corporativo suele estar listo en pocas semanas, según la cantidad de secciones y de lo rápido que recibamos contenidos y materiales. Te damos un plazo claro en la cotización.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const minerales = ['Cobre', 'Litio', 'Oro', 'Hierro', 'Plata', 'Molibdeno', 'Carbón', 'Salitre'];
---

<Layout
  title="Diseño Web Empresas Minería Chile | Páginas Web Sector Minero"
  description="Especialistas en diseño web para empresas mineras en Chile. Páginas web corporativas para minería, contratistas y proveedores del sector. ¡Consulta gratis!"
  keywords="diseño web minería, páginas web empresas mineras, sitios web sector minero Chile, diseño web corporativo minería"
  breadcrumbs={[{ name: "Diseño Web Empresas Minería", url: "https://diseñopaginas.cl/diseno-web-empresas-mineria" }]}
>
  <Header navItems={[
    { label: "Servicios", href: "#servicios" },
    { label: "Empresas", href: "#empresas" },
    { label: "Regiones", href: "#regiones" },
    { label: "Proyectos", href: "#proyectos" },
    { label: "Por qué elegirnos", href: "#por-que" },
    { label: "Preguntas", href: "#faq" },
    { label: "Cotizar", href: "#contacto" },
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <main class="mn">
    <!-- HERO -->
    <section class="mn-hero" id="inicio">
      <div class="mn-wrap mn-hero__in">
        <span class="mn-eyebrow">Especialistas en Sector Minero</span>
        <h1>Diseño Web para <em>Empresas de Minería</em></h1>
        <p class="mn-lead">
          Creamos sitios web corporativos para empresas mineras, contratistas y proveedores del sector
          que proyectan solidez, confianza y profesionalismo. Más de 13 años especializados en el sector minero chileno.
        </p>
        <div class="mn-cta">
          <a href="/contacto" class="mn-btn mn-btn--cu">Consulta Gratuita <i class="ti ti-arrow-right"></i></a>
          <a href="#portafolio-mineria" class="mn-btn mn-btn--ghost">Ver Trabajos</a>
        </div>
        <ul class="mn-chips">
          <li><i class="ti ti-clock-check"></i> +13 años de experiencia</li>
          <li><i class="ti ti-bolt"></i> Sitios ultrarrápidos con Astro</li>
          <li><i class="ti ti-lock"></i> Seguridad corporativa</li>
        </ul>
      </div>
    </section>

    <!-- CINTA DE MINERALES -->
    <div class="mn-band" aria-hidden="true">
      <div class="mn-band__t">
        {[...minerales, ...minerales, ...minerales].map(m => <span>{m}</span>)}
      </div>
    </div>

    <!-- SERVICIOS -->
    <section class="mn-sec" id="servicios">
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Servicios Web Especializados para Minería</h2>
          <p>Soluciones digitales diseñadas específicamente para el sector minero</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {servicios.map((s, i) => (
            <article class="mn-card">
              <span class="mn-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="mn-ico"><i class={`ti ti-${s.icon}`}></i></div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <ul>{s.li.map(x => <li><i class="ti ti-check"></i>{x}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- TIPOS DE EMPRESAS -->
    <section class="mn-sec mn-sec--dark" id="empresas">
      <div class="mn-wrap mn-split">
        <div class="mn-split__txt">
          <header class="mn-head mn-head--left">
            <h2>Tipos de Empresas del Sector Minero</h2>
            <p>Atendemos todo tipo de empresas relacionadas con la minería</p>
          </header>
          <div class="mn-grid mn-grid--2">
            {tipos.map(t => (
              <div class="mn-tile">
                <i class={`ti ti-${t.icon}`}></i>
                <h3>{t.t}</h3>
                <p>{t.d}</p>
              </div>
            ))}
          </div>
        </div>
        <figure class="mn-photo">
          <img src="/assets/img/mineria/excavadora.webp" alt="Excavadora y camión minero en faena" loading="lazy" width="640" height="480" />
        </figure>
      </div>
    </section>

    <!-- REGIONES -->
    <section class="mn-sec" id="regiones">
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Principales Regiones Mineras de Chile</h2>
          <p>Especializados en empresas de las principales zonas mineras del país</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {regiones.map(r => (
            <article class="mn-reg">
              <span class="mn-reg__n">{r.n}</span>
              <h3>{r.t}</h3>
              <p>{r.d}</p>
              <div class="mn-tags">{r.m.map(x => <span>{x}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROYECTOS DEL SECTOR -->
    <section class="mn-sec mn-sec--soft" id="proyectos">
      <span id="portafolio-mineria"></span>
      <div class="mn-wrap">
        <header class="mn-head">
          <h2>Proyectos Web para el Sector Industrial y Minero</h2>
          <p>Sitios reales que hemos desarrollado para empresas del rubro</p>
        </header>
        <div class="mn-grid mn-grid--3">
          {proyectos.map(p => (
            <a class="mn-proj" href={`https://${p.u}`} target="_blank" rel="noopener noreferrer">
              <div class="mn-proj__img"><img src={`/assets/img/portafolio/${p.img}.webp`} alt={`Diseño web ${p.t}`} loading="lazy" width="480" height="285" /></div>
              <div class="mn-proj__t"><strong>{p.t}</strong><span>{p.d}</span><em>{p.u} <i class="ti ti-arrow-up-right"></i></em></div>
            </a>
          ))}
        </div>
        <p class="mn-more"><a href="/portafolio">Ver todo el portafolio <i class="ti ti-arrow-right"></i></a></p>
      </div>
    </section>

    <!-- POR QUÉ ELEGIRNOS -->
    <section class="mn-sec" id="por-que">
      <div class="mn-wrap mn-split mn-split--rev">
        <figure class="mn-photo mn-photo--tall">
          <img src="/assets/img/mineria/camion-aljibe.webp" alt="Operación minera en faena" loading="lazy" width="675" height="585" />
        </figure>
        <div class="mn-split__txt">
          <header class="mn-head mn-head--left">
            <h2>¿Por qué elegir nuestros servicios para su empresa minera?</h2>
          </header>
          <div class="mn-list">
            {razones.map(r => (
              <div class="mn-li">
                <div class="mn-ico mn-ico--sm"><i class={`ti ti-${r.icon}`}></i></div>
                <div><h3>{r.t}</h3><p>{r.d}</p></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mn-sec mn-sec--soft" id="faq">
      <div class="mn-wrap mn-wrap--narrow">
        <header class="mn-head">
          <h2>Preguntas frecuentes sobre diseño web para minería</h2>
        </header>
        <div class="mn-faq">
          {faq.map(f => (
            <details class="mn-faq__i">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="mn-final" id="contacto">
      <div class="mn-wrap">
        <h2>¿Listo para proyectar la solidez de su empresa minera?</h2>
        <p>Consulta gratuita para conocer cómo podemos ayudar a su empresa a destacar en el sector minero</p>
        <div class="mn-cta mn-cta--c">
          <a href="/contacto" class="mn-btn mn-btn--cu"><i class="ti ti-message-circle"></i> Consulta Gratuita</a>
          <a href="tel:+56961765268" class="mn-btn mn-btn--ghost"><i class="ti ti-phone"></i> (+56) 9 61765268</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

<script is:inline>
  (function(){
    var links=[].slice.call(document.querySelectorAll('#disenopaginasNav a.nav-link[href^="#"]')).filter(function(a){return a.getAttribute('href')!=='#contacto'});
    var map=links.map(function(a){return{a:a,el:document.querySelector(a.getAttribute('href'))}}).filter(function(x){return x.el});
    function upd(){var y=window.scrollY+140,cur=null;map.forEach(function(x){var t=x.el.getBoundingClientRect().top+window.scrollY;if(t<=y)cur=x});links.forEach(function(a){a.classList.toggle('on',!!cur&&cur.a===a)})}
    window.addEventListener('scroll',upd,{passive:true});upd();
    document.querySelectorAll('#disenopaginasNav a').forEach(function(a){a.addEventListener('click',function(){var c=document.getElementById('disenopaginasNav');if(c&&c.classList.contains('show'))c.classList.remove('show')})});
  })();
</script>
</Layout>

<style is:global>
  .mn{--ink:#0B111B;--ink2:#121A28;--ink3:#1B2536;--cu:#E08A3C;--cu2:#F4B26E;--bl:#447DE9;--tx:#1E2536;--mut:#5B6577;--line:#E3E7EE;--soft:#F5F7FA;font-family:'Inter',system-ui,sans-serif;color:var(--tx);background:#fff}
  .mn h1,.mn h2,.mn h3{font-family:'Sora','Outfit',sans-serif;margin:0}
  .mn-wrap{width:min(1180px,100% - 2rem);margin-inline:auto}
  .mn-wrap--narrow{width:min(860px,100% - 2rem)}


  html{scroll-behavior:smooth}
  .mn-hero,.mn-sec,.mn-final{scroll-margin-top:110px}
  #disenopaginasNav .nav-link.on{color:#E08A3C !important}

  /* HERO */
  .mn-hero{position:relative;color:#fff;background:linear-gradient(90deg,rgba(11,17,27,.94) 0%,rgba(11,17,27,.78) 48%,rgba(11,17,27,.35) 100%),url('/assets/img/mineria/hero-mineria.webp') center/cover no-repeat;padding:clamp(8.8rem,14vw,11rem) 0 clamp(3.5rem,8vw,6rem);overflow:hidden}
  .mn-hero::after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--cu),var(--cu2),transparent)}
  .mn-hero__in{position:relative}
  .mn-eyebrow{display:inline-block;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--cu2);padding:.45rem .9rem;border:1px solid rgba(244,178,110,.45);border-radius:99px;background:rgba(224,138,60,.1);margin-bottom:1.4rem}
  .mn-hero h1{font-size:clamp(2rem,5.4vw,3.6rem);line-height:1.08;font-weight:700;letter-spacing:-.01em;max-width:19ch;text-wrap:balance;color:#fff}
  .mn-hero h1 em{font-style:normal;color:var(--cu2)}
  .mn-lead{margin:1.4rem 0 0;max-width:40rem;font-size:clamp(1rem,1.5vw,1.15rem);line-height:1.7;color:#E6EBF3;text-wrap:pretty}
  .mn-cta{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
  .mn-cta--c{justify-content:center}
  .mn-btn{display:inline-flex;align-items:center;gap:.55rem;padding:.95rem 1.6rem;border-radius:12px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid transparent;transition:transform .2s,box-shadow .2s,background .2s}
  .mn-btn:hover{transform:translateY(-2px)}
  .mn-btn--cu{background:linear-gradient(135deg,var(--cu2),var(--cu));color:#1A1209;box-shadow:0 12px 26px -12px rgba(224,138,60,.7)}
  .mn-btn--cu:hover{color:#1A1209;box-shadow:0 18px 32px -12px rgba(224,138,60,.85)}
  .mn-btn--ghost{background:rgba(255,255,255,.06);color:#fff;border-color:rgba(255,255,255,.35);backdrop-filter:blur(4px)}
  .mn-btn--ghost:hover{background:rgba(255,255,255,.14);color:#fff}
  .mn-chips{list-style:none;padding:0;margin:2.4rem 0 0;display:flex;flex-wrap:wrap;gap:.7rem}
  .mn-chips li{display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1rem;border-radius:99px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);font-size:.9rem;color:#EAF0F8}
  .mn-chips i{color:var(--cu2);font-size:1.1rem}

  /* CINTA */
  .mn-band{background:var(--ink);overflow:hidden;border-bottom:1px solid #1d2738}
  .mn-band__t{display:flex;gap:3rem;width:max-content;padding:1rem 0;animation:mn-slide 38s linear infinite}
  .mn-band__t span{font-family:'Sora',sans-serif;font-size:.85rem;letter-spacing:.22em;text-transform:uppercase;color:#7C8AA3;white-space:nowrap}
  .mn-band__t span::after{content:"◆";margin-left:3rem;color:var(--cu);font-size:.6rem;vertical-align:middle}
  @keyframes mn-slide{to{transform:translateX(-33.333%)}}
  @media (prefers-reduced-motion:reduce){.mn-band__t{animation:none}}

  /* SECCIONES */
  .mn-sec{padding:clamp(3.2rem,7vw,5.5rem) 0}
  .mn-sec--soft{background:var(--soft)}
  .mn-sec--dark{background:var(--ink2);color:#DCE3EE}
  .mn-head{text-align:center;max-width:46rem;margin:0 auto clamp(1.8rem,4.5vw,2.8rem)}
  .mn-head--left{text-align:left;margin-inline:0}
  .mn-head h2{font-size:clamp(1.55rem,3.4vw,2.2rem);line-height:1.22;font-weight:700;letter-spacing:-.005em;text-wrap:balance;color:var(--tx)}
  .mn-head p{margin:.8rem 0 0;color:var(--mut);font-size:1.05rem;text-wrap:pretty}
  .mn-sec--dark .mn-head h2{color:#fff}
  .mn-sec--dark .mn-head p{color:#A9B6CA}
  .mn-grid{display:grid;gap:1.2rem}
  .mn-grid--3{grid-template-columns:repeat(3,1fr)}
  .mn-grid--2{grid-template-columns:repeat(2,1fr)}
  @media(max-width:991px){.mn-grid--3{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.mn-grid--3,.mn-grid--2{grid-template-columns:1fr}}

  /* TARJETAS DE SERVICIO */
  .mn-card{position:relative;background:#fff;border:1px solid var(--line);border-radius:18px;padding:1.7rem;box-shadow:0 14px 34px -26px rgba(11,17,27,.35);transition:transform .3s,box-shadow .3s,border-color .3s}
  .mn-card:hover{transform:translateY(-4px);border-color:rgba(224,138,60,.5);box-shadow:0 22px 40px -24px rgba(11,17,27,.4)}
  .mn-num{position:absolute;top:1.3rem;right:1.4rem;font-family:'Sora',sans-serif;font-size:.85rem;font-weight:600;color:#C5CCD9;letter-spacing:.08em}
  .mn-ico{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(145deg,#FFF3E4,#FFE2C2);color:#B9651D;font-size:1.6rem;margin-bottom:1.1rem}
  .mn-ico--sm{width:46px;height:46px;font-size:1.35rem;flex:0 0 46px;margin:0}
  .mn-card h3{font-size:1.12rem;font-weight:700;margin-bottom:.5rem;color:var(--tx)}
  .mn-card p{color:var(--mut);margin:0 0 1rem;line-height:1.65}
  .mn-card ul{list-style:none;padding:0;margin:0;display:grid;gap:.4rem}
  .mn-card li{display:flex;gap:.55rem;align-items:center;font-size:.93rem;color:var(--tx)}
  .mn-card li i{color:var(--cu);font-size:1rem}

  /* SPLIT */
  .mn-split{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(1.8rem,4vw,3.5rem);align-items:center}
  .mn-split--rev{grid-template-columns:.9fr 1.1fr}
  @media(max-width:900px){.mn-split,.mn-split--rev{grid-template-columns:1fr}.mn-photo{order:-1}}
  .mn-photo{margin:0;border-radius:22px;overflow:hidden;position:relative;box-shadow:0 30px 60px -34px rgba(0,0,0,.6)}
  .mn-photo img{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:4/3}
  .mn-photo--tall img{aspect-ratio:1/1}
  .mn-photo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(11,17,27,.45));pointer-events:none}
  .mn-tile{padding:1.3rem;border-radius:16px;background:var(--ink3);border:1px solid #28344a;transition:border-color .3s,transform .3s}
  .mn-tile:hover{border-color:var(--cu);transform:translateY(-3px)}
  .mn-tile i{font-size:1.7rem;color:var(--cu2)}
  .mn-tile h3{font-size:1.02rem;color:#fff;margin:.7rem 0 .25rem}
  .mn-tile p{margin:0;color:#A9B6CA;font-size:.92rem}

  /* REGIONES */
  .mn-reg{background:#fff;border:1px solid var(--line);border-radius:18px;padding:1.7rem;position:relative;overflow:hidden}
  .mn-reg::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--cu2),var(--cu))}
  .mn-reg__n{font-family:'Sora',sans-serif;font-size:2.4rem;font-weight:700;color:#EEF1F6;line-height:1}
  .mn-reg h3{font-size:1.15rem;margin:.6rem 0 .3rem;color:var(--tx)}
  .mn-reg p{color:var(--mut);margin:0 0 1rem}
  .mn-tags{display:flex;flex-wrap:wrap;gap:.45rem}
  .mn-tags span{font-size:.8rem;padding:.3rem .7rem;border-radius:99px;background:#FFF3E4;color:#9A5416;font-weight:600}

  /* PROYECTOS */
  .mn-proj{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;text-decoration:none;color:var(--tx);box-shadow:0 14px 34px -26px rgba(11,17,27,.35);transition:transform .3s,box-shadow .3s}
  .mn-proj:hover{transform:translateY(-4px);box-shadow:0 24px 44px -26px rgba(11,17,27,.5);color:var(--tx)}
  .mn-proj__img{aspect-ratio:480/285;background:var(--soft);overflow:hidden}
