---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Services2 from '../components/Services2.astro';
import Proceso from '../components/Proceso.astro';
import AlgunosTrabajos from '../components/AlgunosTrabajos.astro';
import Testimonials from '../components/Testimonials.astro';

---
<Layout 
  title="Diseño Páginas Web Chile │ Sitios Web Profesionales para Empresas"
  description="Diseño web en Chile para empresas y pymes. Diseño de páginas web profesionales: +13 años de experiencia, sitios rápidos con Astro y SEO. Cotiza gratis."
  canonical="https://diseñopaginas.cl/"
>
   <!-- Schema FAQPage — solo en la home (movido desde Layout.astro) -->
   <script type="application/ld+json">
   {
     "@context": "https://schema.org",
     "@type": "FAQPage",
     "mainEntity": [
       {
         "@type": "Question",
         "name": "¿Cuánto cuesta una página web en Chile?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "El precio de una página web en Chile varía según el tipo de proyecto. Una página web corporativa básica parte desde $200.000 CLP, un sitio autoadministrable (con panel para editar contenidos) entre $300.000 y $600.000 CLP, y una tienda online con WooCommerce desde $500.000 CLP. En DiseñoPaginas.cl ofrecemos tarifas claras y sin costos ocultos, con más de 13 años de experiencia creando sitios web profesionales para empresas chilenas."
         }
       },
       {
         "@type": "Question",
         "name": "¿Cuánto tiempo demora hacer una página web?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "El tiempo de desarrollo depende del tipo de sitio web. Una página web corporativa tarda entre 2 y 4 semanas. Un sitio autoadministrable puede demorar de 3 a 5 semanas. Una tienda online completa entre 4 y 8 semanas. El plazo exacto se acuerda al inicio del proyecto según los requerimientos y la rapidez con que el cliente entrega la información necesaria."
         }
       },
       {
         "@type": "Question",
         "name": "¿Qué incluye el diseño web profesional?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "El diseño web profesional en DiseñoPaginas.cl incluye: diseño personalizado adaptado a la identidad de tu marca, versión responsive para móviles y tablets, optimización SEO básica, integración con redes sociales, formulario de contacto, Google Analytics, configuración de dominio y hosting, y soporte técnico post-lanzamiento. Para sitios Astro se incluye además rendimiento de carga excepcional con puntajes superiores al 95 en Google PageSpeed."
         }
       },
       {
         "@type": "Question",
         "name": "¿Qué es el posicionamiento SEO y por qué lo necesita mi empresa?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "El posicionamiento SEO (Search Engine Optimization) es el conjunto de técnicas que permiten que tu sitio web aparezca en los primeros resultados de Google cuando alguien busca tus servicios o productos. Sin SEO, tu página existe en internet pero nadie la encuentra. Con una estrategia SEO correcta, tu empresa aparece ante clientes que ya están buscando lo que ofreces, generando tráfico orgánico gratuito y sostenible a largo plazo."
         }
       },
       {
         "@type": "Question",
         "name": "¿Ofrecen diseño web en todo Chile o solo en Temuco?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "DiseñoPaginas.cl ofrece servicios de diseño web a empresas de todo Chile. Trabajamos con clientes en Santiago, Temuco, Concepción, Valparaíso, Antofagasta, La Serena, Valdivia, Osorno, Puerto Montt y Arica, entre otras ciudades. Al ser un servicio 100% digital, la distancia no es un obstáculo. Nos comunicamos por videollamada, WhatsApp y correo electrónico durante todo el proceso."
         }
       },
       {
         "@type": "Question",
         "name": "¿Qué ventaja tiene una página web hecha con Astro?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "Astro es un framework moderno que genera sitios web ultrarrápidos enviando cero JavaScript al navegador por defecto. Esto resulta en tiempos de carga inferiores a 1 segundo, puntajes de Google PageSpeed superiores a 95/100, mejor posicionamiento SEO (Google premia la velocidad), y mejor experiencia de usuario. En DiseñoPaginas.cl somos especialistas en desarrollo con Astro, lo que significa que tu sitio web será significativamente más rápido que el 90% de los sitios de la competencia."
         }
       },
       {
         "@type": "Question",
         "name": "¿Puedo administrar mi propia página web sin saber programar?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "Sí. Los sitios web autoadministrables que creamos en DiseñoPaginas.cl incluyen un panel de control intuitivo (WordPress) que te permite actualizar textos, imágenes, agregar noticias o cambiar información sin necesidad de conocimientos técnicos. Además, incluimos capacitación para que aprendas a usar el sistema y soporte técnico por teléfono ante cualquier duda."
         }
       },
       {
         "@type": "Question",
         "name": "¿Realizan mantenimiento y actualización de páginas web ya existentes?",
         "acceptedAnswer": {
           "@type": "Answer",
           "text": "Sí, ofrecemos servicio de mantenimiento web profesional para sitios existentes. Esto incluye actualización de contenidos, optimización de rendimiento, copias de seguridad regulares, monitoreo de seguridad, actualización de plugins y corrección de errores. También realizamos rediseños completos de sitios web obsoletos o que no generan los resultados esperados."
         }
       }
     ]
   }
   </script>

   <!-- Hero Section -->
   <Hero />

   <!-- Intro SEO: refuerza keywords del grupo 1 (diseño de páginas web / crear página web) -->
   <section class="intro-home py-5" aria-label="Diseño de páginas web en Chile">
      <div class="container">
         <div class="row align-items-center g-4 g-lg-5">
            <div class="col-12 col-lg-6">
               <img
                  src="/assets/img/heroes/diseno-web-chile-mockup.webp"
                  alt="Diseño de páginas web para empresas y pymes en Chile"
                  width="700" height="486"
                  loading="lazy" decoding="async"
                  class="img-fluid intro-anim" />
            </div>
            <div class="col-12 col-lg-6">
               <h2 class="mb-3">Diseño de páginas web para empresas y pymes en Chile</h2>
               <p class="mb-4" style="font-size: 1.05rem; line-height: 1.7;">
                  Creamos el <strong>diseño de páginas web</strong> que tu negocio necesita para vender más.
                  Ofrecemos <strong>diseño web en Chile para empresas</strong> y pymes de todos los rubros.
                  Si quieres <strong>crear tu página web profesional en Chile</strong>, diseñamos sitios rápidos,
                  modernos y optimizados para aparecer en Google.
               </p>
               <a href="/contacto" class="btn btn-primary">Cotiza tu página web <i class="ti ti-arrow-up-right"></i></a>
            </div>
         </div>
      </div>
   </section>

   <style>
      /* Entrada de la imagen del mockup al hacer scroll a la sección */
      .intro-anim.anim-ready {
         opacity: 0;
         transform: translateX(-45px);
         transition: opacity .8s ease, transform .8s ease;
         will-change: opacity, transform;
      }
      .intro-anim.anim-ready.is-visible {
         opacity: 1;
         transform: translateX(0);
      }
      @media (prefers-reduced-motion: reduce) {
         .intro-anim.anim-ready { opacity: 1; transform: none; transition: none; }
      }
      /* Hover del botón: texto en celeste del logo en vez de oscuro */
      .intro-home .btn-primary:hover,
      .intro-home .btn-primary:focus {
         color: #00F4F3 !important;
      }
   </style>

   <script>
      const introImg = document.querySelector('.intro-anim');
      if (introImg && 'IntersectionObserver' in window) {
         introImg.classList.add('anim-ready');
         const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
               if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
               }
            });
         }, { threshold: 0.3 });
         io.observe(introImg);
      }
   </script>

   <Services />
   <AlgunosTrabajos />
   <Services2 />

   <!-- Proyecto Web Banner Section -->
   <section class="proyecto-web-banner">
      <div class="container">
         <div class="row align-items-center g-4 g-xl-5">
            <div class="col-12 col-lg-7">
               <h2 class="pwb-title">¿Qué necesito para comenzar mi proyecto web?</h2>
               <p class="pwb-lead">Para comenzar tu proyecto web, necesitas:</p>
               <ol class="requisitos-list list-unstyled">
                  <li class="requisito-item"><span class="req-num">1</span><span>Información básica de tu empresa</span></li>
                  <li class="requisito-item"><span class="req-num">2</span><span>Contenido (textos e imágenes) que quieras incluir</span></li>
                  <li class="requisito-item"><span class="req-num">3</span><span>Ejemplos de sitios web que te gusten</span></li>
                  <li class="requisito-item"><span class="req-num">4</span><span>Objetivos del sitio web</span></li>
                  <li class="requisito-item"><span class="req-num">5</span><span>Dominio (si ya lo tienes)</span></li>
               </ol>
               <div class="pwb-note">
                  <i class="ti ti-info-circle" aria-hidden="true"></i>
                  <p class="mb-0"><span>¿No tienes alguno de estos elementos? ¡No te preocupes!</span> Podemos asesorarte en cada paso del proceso.</p>
               </div>
            </div>
            <div class="col-12 col-lg-5">
               <div class="banner-cta">
                  <span class="pwb-cta-icon" aria-hidden="true"><i class="ti ti-rocket"></i></span>
                  <h3 class="pwb-cta-title">Comienza tu sitio web profesional hoy</h3>
                  <a href="/contacto" class="btn btn-primary">Comenzar Ahora <i class="ti ti-arrow-up-right"></i></a>
               </div>
            </div>
         </div>
      </div>
   </section>
   
   <Testimonials />
   <Proceso />

   <!-- Sección E-E-A-T: Quiénes somos — señales de autoridad para Google e IAs -->
   <section class="eeat-section section-padding bg-light" aria-label="Sobre DiseñoPaginas.cl">
      <div class="container">
         <div class="row justify-content-center">
            <div class="col-lg-10">
               <h2 class="text-center mb-5">Diseño web en Chile con experiencia real</h2>

               <div class="eeat-content">
                  <p>
                     <strong>DiseñoPaginas.cl</strong> es una agencia de <a href="/servicios/diseno-web-chile">diseño web profesional</a> fundada en 2012
                     por <strong>Raúl Riquelme</strong>, diseñador gráfico y desarrollador web con formación
                     universitaria y más de <strong>13 años de experiencia</strong> creando sitios web para
                     empresas chilenas.
                  </p>

                  <p>
                     Hemos desarrollado <strong>más de 200 proyectos web</strong> para empresas de distintos
                     rubros: abogados, clínicas dentales, psicólogos, empresas industriales, <a href="/servicios/tiendas-online">tiendas online</a>,
                     corredor de propiedades y muchos más. Trabajamos con clientes en todo Chile, desde
                     Arica hasta Puerto Montt, de forma 100% digital.
                  </p>

                  <p>
                     Somos especialistas en <strong><a href="/servicios/paginas-rapida-astro">desarrollo web con Astro</a></strong>, el framework moderno que
                     genera sitios ultrarrápidos con puntajes de Google PageSpeed superiores a 95/100.
                     También desarrollamos sitios autoadministrables con WordPress y tiendas online con
                     WooCommerce.
                  </p>

                  <p>
                     Contamos con <strong>certificaciones Google</strong> en herramientas digitales y aplicamos
                     las últimas técnicas de <strong><a href="/servicios/posicionamiento-web-seo">posicionamiento SEO</a></strong> validadas por Google para
                     que tu empresa aparezca en los primeros resultados de búsqueda de forma sostenida.
                  </p>

                  <div class="eeat-highlights mt-5">
                     <h3 class="h5 mb-4">Experiencia verificable</h3>
                     <ul class="eeat-list">
                        <li>+13 años de experiencia en diseño y desarrollo web</li>
                        <li>+200 proyectos web entregados en Chile</li>
                        <li>Fundado en 2012 — más de una década en el mercado chileno</li>
                        <li>Formación universitaria en Diseño Gráfico y Diseño Web</li>
                        <li>Certificaciones Google en herramientas digitales</li>
                        <li>Especialistas en Astro, WordPress, WooCommerce y Figma</li>
                        <li>SEO local para todo Chile: Santiago, Temuco, Concepción y más</li>
                     </ul>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </section>
   
</Layout> 

<style>
.proyecto-web-banner {
  padding: clamp(56px, 7vw, 96px) 0;
  background: linear-gradient(180deg, #f7f9fd 0%, #f1f5fb 100%);
  border-top: 1px solid #e4eaf4;
}
.pwb-title {
  color: #24324d;
  font-weight: 600;
  font-size: clamp(1.6rem, 2.4vw, 2.1rem);
  line-height: 1.25;
  margin-bottom: 12px;
}
.pwb-lead { color: #5b6780; margin-bottom: 24px; }

.requisitos-list {
  margin: 0 0 20px;
  padding: 8px 24px;
  background: #fff;
  border: 1px solid #e4eaf4;
  border-radius: 16px;
  box-shadow: 0 12px 30px -20px rgba(36, 50, 77, .25);
}
.requisito-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid #eef2f8;
  color: #3a4660;
  font-weight: 500;
  font-size: 1.02rem;
}
.requisito-item:last-child { border-bottom: none; }
.req-num {
  display: grid;
  place-items: center;
  flex: none;
  width: 30px; height: 30px;
  border-radius: 50%;
  background: #edf2fd;
  color: #3f63d8;
  font-size: .85rem;
  font-weight: 600;
}

.pwb-note {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 18px;
  background: #eef3fd;
  border-radius: 12px;
  color: #5b6780;
  font-size: .95rem;
}
.pwb-note i { color: #3f63d8; font-size: 1.25rem; line-height: 1.3; }
.pwb-note span { color: #3f63d8; font-weight: 600; }

.banner-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 18px;
  padding: clamp(32px, 4vw, 48px) 32px;
  background: linear-gradient(145deg, #eaf8fb 0%, #eef2fd 100%);
  border: 1px solid #dce8f6;
  border-radius: 20px;
}
.pwb-cta-icon {
  display: grid;
  place-items: center;
  width: 56px; height: 56px;
  border-radius: 16px;
  background: #fff;
  color: #3f63d8;
  font-size: 1.6rem;
  box-shadow: 0 10px 24px -12px rgba(63, 99, 216, .45);
}
.pwb-cta-title {
  color: #24324d;
  font-weight: 600;
  font-size: clamp(1.3rem, 1.9vw, 1.6rem);
  line-height: 1.3;
  margin: 0;
}

@media (max-width: 768px) {
  .requisitos-list { padding: 4px 18px; }
  .banner-cta { padding: 30px 20px; }
}

/* Estilos E-E-A-T */
.eeat-section {
  padding: 80px 0;
}

.eeat-content p {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #333;
  margin-bottom: 1.5rem;
}

.eeat-content strong {
  color: #011C42;
  font-weight: 600;
}

.eeat-highlights {
  background: white;
  padding: 30px;
  border-radius: 10px;
  border-left: 4px solid #2F5FA8;
  box-shadow: 0 2px 15px rgba(0,0,0,0.08);
}

.eeat-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.eeat-list li {
  padding: 10px 0;
  padding-left: 30px;
  position: relative;
  color: #333;
  font-size: 1.05rem;
}

.eeat-list li:before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #2F5FA8;
  font-weight: bold;
  font-size: 1.2rem;
}
</style> 